say "=== Memory Starting ==="
say mem_human()

repeat 500
    tick()

    repeat kingdoms
        population_pressure(it)

        chance | pick 1 from 1...1000
        if chance > 975
            event(it)
        end
    xx
end

say "=== Memory Ending ==="
say mem_human()

say "=== KINGDOMS ==="
repeat kingdoms
    say it
xx

say "=== RELIGIONS ==="
repeat religions
    say it
xx

say "=== FACTIONS ==="
repeat factions
    say it
xx

say "=== OVERLAYS ==="
repeat overlays
    say it
xx
