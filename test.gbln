            horses:      (self >> horses) + (target >> horses)
            stone:       (self >> stone) + (target >> stone)
            relics:      (self >> relics) + (target >> relics)
            ships:       (self >> ships) + (target >> ships)
        end
        overlays: split
        links: inherit
    end


end




@Religion |
    zeal: .5
    mercy: .5
    order: .5
    mysticism: .5
    margin: .08

    transition split when (self >> zeal) > .92 and (self >> mercy) < .22 and (self >> order) > .82 and (self >> mysticism) > .35
        into Religion, Religion
        first:
            zeal:      (self >> zeal)
            mercy:     (self >> mercy)
            order:     (self >> order)
            mysticism: (self >> mysticism) * .7
            margin:    (self >> margin) + .08
        end
        second:
            zeal:      (self >> zeal) * .62
            mercy:     (self >> mercy) + .22
            order:     (self >> order) * .62
            mysticism: (self >> mysticism) + .12
            margin:    (self >> margin) + .12
        end
        overlays: split
        links: reset
    end

    transition mutate when (self >> mysticism) > .9 and (self >> order) < .22 and (self >> zeal) < .45
        into Religion
        carries:
            zeal:      (self >> zeal) * .75
            mercy:     (self >> mercy) + .08
            order:     .18
            mysticism: 1
            margin:    (self >> margin) + .1
        end
        overlays: transfer
        links: reset
    end
end


@Faction |
    loyalty: .5
    greed: .5
    influence: .5
    militancy: .5
    margin: .08

    transition split when (self >> loyalty) < .5 and (self >> greed) > .8 and (self >> influence) > .75
        into Faction, Faction
        first:
            loyalty:   (self >> loyalty)
            greed:     (self >> greed)
            influence: (self >> influence) * .6
            militancy: (self >> militancy) + .1
            margin:    (self >> margin)
        end
        second:
            loyalty:   (self >> loyalty) + .1
            greed:     (self >> greed) * .7
            influence: (self >> influence) * .4
            militancy: (self >> militancy) * .8
            margin:    (self >> margin)
        end
        overlays: split
        links: reset
    end

    transition mutate when (self >> militancy) > .82 and (self >> loyalty) < .72 and (self >> influence) > .7
        into Faction
        carries:
            loyalty:   .2
            greed:     (self >> greed) + .1
            influence: (self >> influence) * .8
            militancy: 1
            margin:    (self >> margin)
        end
        overlays: transfer
        links: reset
    end

    transition absorb(Faction) when (self >> influence) > (target >> influence) * 2.4 and (self >> greed) > .85
        carries:
            loyalty:   (self >> loyalty) - .05
            greed:     (self >> greed)
            influence: (self >> influence) + (target >> influence) * .6
            militancy: (self >> militancy)
            margin:    (self >> margin)
        end
        overlays: transfer
        links: inherit
    end

    transition subjugate(Faction) when (self >> influence) > (target >> influence) * 2.1 and (self >> militancy) > .85
        overlays: transfer
        links: inherit
    end
end


