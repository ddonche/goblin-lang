@Nation |
    power:       .5
    military:    .5
    economy:     .5
    trust:       .5
    aggression:  .5
    cooperation: .5
end

link Nation border by [
    self >> military * .4
    + self >> aggression * .3
    - target >> military * .3
]

link Nation trade by [
    self >> economy * .4
    + self >> cooperation * .4
    + target >> economy * .2
]

link Nation culture by [
    self >> trust * .5
    + target >> trust * .5
]

@Nation matrix
    id:          "{id}", Rome,  Carthage, Greece
    power:       .5,     .8,    .6,       .5
    military:    .5,     .9,    .5,       .4
    economy:     .5,     .6,    .8,       .7
    trust:       .5,     .3,    .5,       .8
    aggression:  .5,     .8,    .4,       .2
    cooperation: .5,     .3,    .7,       .8
end

say "=== INITIAL LINK SCORES ==="
say "Rome -> Carthage border:"
say link_score("Nation", "border", "Rome", "Carthage")
say "Rome -> Carthage trade:"
say link_score("Nation", "trade", "Rome", "Carthage")
say "Rome -> Carthage culture:"
say link_score("Nation", "culture", "Rome", "Carthage")
say "Greece -> Rome trade:"
say link_score("Nation", "trade", "Greece", "Rome")

say "=== OBJECT OVERRIDE ==="
Rome link border by [
    self >> military * .7
    - target >> military * .3
]
say "Rome -> Carthage border (Rome's own formula):"
say link_score("Nation", "border", "Rome", "Carthage")
say "Carthage -> Rome border (still class formula):"
say link_score("Nation", "border", "Carthage", "Rome")

say "=== PAIR OFFSETS ==="
Rome link to Carthage on culture offset -.5
say "Rome -> Carthage culture after betrayal:"
say link_score("Nation", "culture", "Rome", "Carthage")

Rome link to Greece on trade offset +.3 for 5 ticks
say "Rome -> Greece trade after treaty (temporary):"
say link_score("Nation", "trade", "Rome", "Greece")

say "=== AFTER 5 TICKS ==="
repeat 5
    tick()
xx
say "Rome -> Greece trade after treaty expires:"
say link_score("Nation", "trade", "Rome", "Greece")