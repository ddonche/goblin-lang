    horses: 80
    stone: 250
    relics: 4
    ships: 10
    margin: .09

    transition absorb(Kingdom) when (self >> power) > (target >> power) * 1.8 and (target >> population) < 50000 and (target >> stability) < .35
        carries:
            aggression: self >> aggression + ((target >> fear) * .04)
