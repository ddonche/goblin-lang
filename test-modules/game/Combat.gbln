
/// This does not work right
act fight(attacker, defender)
    /// say attacker >> name ++ "attacks" ++ defender >> name + "!"
    say((attacker >> name) ++ "attacks" ++ (defender >> name) + "!") <---- this also works
end

//// This works right
act fight(attacker, defender)
    a = attacker >> name
    b = " attacks "
    c = defender >> name
    msg = a + b + c + "!"
    say msg
end
