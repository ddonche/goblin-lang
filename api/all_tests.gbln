/// format_basic.gbln
say "=== testing formatting ==="
treasure_hoard_amount | 1234567.89

/// Full spec (US style): (decimals, thousands, decimal)
gbln_format_smoke_us | treasure_hoard_amount.format(2 , .)
say gbln_format_smoke_us        /// expect: 1,234,567.89

/// Short form: decimals only (no thousands separator)
gbln_format_smoke_plain | treasure_hoard_amount.format(2)
say gbln_format_smoke_plain     /// expect: 1234567.89

/// format_rewrap_and_clear.gbln

gbln_format_base_number | 10000

/// US grouping (thousands ',', decimal '.')
gbln_format_us | gbln_format_base_number.format(0 , .)
say gbln_format_us              /// expect: 10,000

/// Re-wrap: European style (thousands '.', decimal ',')
gbln_format_eu | gbln_format_us.format(3 . ,)
say gbln_format_eu              /// expect: 10.000,000

/// Clear back to raw number
gbln_format_raw | clear_format(gbln_format_eu)
say gbln_format_raw + "\n"            /// expect: 10000


/// pull 4 codes
say "=== testing pick with letters ==="
repeat 4
    say upper pick 4 from "a"..."z" without dups
xx

/// single return
action calculate_tax(income, rate)
    tax_amount | income * rate
    return tax_amount
xx
total | calculate_tax(50000, 0.15)
say "tax=" ++ total

/// multiple returns
action divide_with_remainder(a, b)
    q | a // b
    r | a % b
    return q, r
xx
res | divide_with_remainder(17, 5)
say "q=" ++ (res >> q) ++ " r=" ++ (res >> r)

/// bare return (early exit)
action early_exit(flag)
    if flag
        return
    xx
    x | 42
    return x
xx
v1 | early_exit(true)
v2 | early_exit(false)
say "early_nil?=" ++ (v1 == nil)
say "early_x=" ++ v2

/// fallthrough = nil
action falloff()
    a | 10
    b | 20
xx
f | falloff()
say "falloff_nil?=" ++ (f == nil)

