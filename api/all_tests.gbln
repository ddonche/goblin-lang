    name: "Default",
    email?: nil
    
    act greet
        say "Hello, " ++ name
    end
end

user|User = { id: 1, name: "Alice", email: "alice@example.com" }
user.greet

/// Test 2: Full nullable and readonly test (final working version)
@User = 
    id!: 0,
    name: "Default",
    email?: nil
    act greet
        say "Hello, " ++ name
    end
    
    act show_email
        say email ?? "No email provided"
    end
end

user1|User = { 1, "Alice", "alice@example.com" }
user1.greet
user1.show_email

user2|User = { id: 2, name: "Bob", email: nil }
user2.greet
user2.show_email

