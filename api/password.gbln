act generate_password
    symbols = "!@#$%^&*()-_=+[]|;:,.<>?"

    repeat 10
        r_num = pick 1 from 3..8
        r_let = pick 1 from 5..12
        r_sym = pick 1 from 2..5

        nums_arr    = pick {r_num} from 0...9 with dups        /// [8,3,0,...]
        letters_arr = pick {r_let} from "a"..."z" with dups    /// ["a","b",...]
        sym_arr     = pick {r_sym} from symbols with dups      /// ["#", "$", ...]

        /// pack digits -> Int (true inverse of the old digits() built-in), then cast to str at print-time
        num_int  = pack(nums_arr)
        nums_str = "" + num_int                                /// beware: leading zeros collapse

        letters = pack(letters_arr).mixed
        syms    = pack(sym_arr)

        say ( (nums_str + letters + syms).shuffle ) ++ "\n"
    end
end

generate_password()