act generate_password
    symbols = raw "!@#$%^&*()-_=+[]|;:{},.<>?"
    repeat 10
        r_num = pick 1 from 3..8                                
        r_let = pick 1 from 5..12                               
        r_sym = pick 1 from 2..5                                

        nums_arr    = pick {r_num} from 0...9 with dups         
        letters_arr = pick {r_let} from "a"..."z" with dups     
        sym_arr     = pick {r_sym} from symbols with dups       

        numbers  = pack(nums_arr)                                
        numbers = numbers.str                                   

        letters = pack(letters_arr).mixed                       
        syms    = raw pack(sym_arr)                             

        password = raw (numbers + letters + syms)               
        say raw shuffle(password)                       
    end
end
generate_password()