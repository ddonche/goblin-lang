/// Day Zero Cipher Decoder (lean, clamp + is_digits + =>)
/// Input: 4-digit code (col,row,dir,dist). Output: 4-letter result.

GRID = [
    ["V","P","W","J","T","R","I","D","G","B"],   <--- row 1
    ["C","G","H","E","L","A","T","P","K","Z"],   <--- row 2
    ["E","N","F","X","Y","Z","C","O","W","I"],   <--- row 3
    ["Q","V","M","S","Q","X","U","G","L","S"],   <--- row 4
    ["B","R","K","N","D","M","W","B","O","A"],   <--- row 5
    ["Z","D","E","U","R","S","K","M","Q","Y"],   <--- row 6
    ["F","A","J","Y","B","Z","H","T","N","L"],   <--- row 7
    ["U","O","I","L","C","N","J","E","D","V"],   <--- row 8
    ["P","Y","Q","H","F","U","V","W","J","R"]    <--- row 9
]

DIRS = [
    [-1,  0],   <--- 1 ↑
    [-1,  1],   <--- 2 ↗
    [ 0,  1],   <--- 3 →
    [ 1,  1],   <--- 4 ↘
    [ 1,  0],   <--- 5 ↓
    [ 1, -1],   <--- 6 ↙
    [ 0, -1],   <--- 7 ←
    [-1, -1]    <--- 8 ↖
]

act flip_dir(d) => ((d + 3) % 8) + 1   <--- 1↔5, 2↔6, …, 8↔4

act letter_at(row, col)
    r_index = clamp(int(row - 1), 0, 8)   <--- keep index in 0..8
    c_index = clamp(int(col),      0, 9)   <--- keep index in 0..9
    row_arr = GRID[r_index]
    return row_arr[c_index]
end

act step(row, col, dir, dist)
    use_dir = dir
    dv = DIRS[int(use_dir - 1)]
    tr = row + dv[0] * dist
    tc = col + dv[1] * dist

    if tr < 1 <> tr > 9 <> tc < 0 <> tc > 9
        use_dir = flip_dir(dir)
        dv = DIRS[int(use_dir - 1)]
        tr = row + dv[0] * dist
        tc = col + dv[1] * dist
    end

    land_row = clamp(tr, 1, 9)
    land_col = clamp(tc, 0, 9)
    return [land_row, land_col, use_dir]
end

act dayzero_decode4(col, row, dir, dist)
    r = row
    c = col
    d = dir
    out = ""
    repeat 4
        stepres = step(r, c, d, dist)
        r = stepres[0]
        c = stepres[1]
        out = out + letter_at(r, c)
        d = (d % 8) + 1   <--- rotate cw (1→…→8→1)
    end
    return out
end

act dayzero_decode_str(code)
    s = code + ""
    if len(s) != 4
        return "ERR"                              <--- wrong length
    end
    if !s.is_digit
        return "ERROR: you must enter only digits"
    end

    d0 = int(s[0:1])   <--- col  0..9
    d1 = int(s[1:2])   <--- row  1..9
    d2 = int(s[2:3])   <--- dir  1..8
    d3 = int(s[3:4])   <--- dist 1..4

    judge
        d2 < 1 <> d2 > 8: return "ERROR: third digit cannot be 0 or 9"
        d3 < 1 <> d3 > 4: return "ERROR: last digit must be 1-4"
    end

    return dayzero_decode4(d0, d1, d2, d3)
end

act main
    code_input = ask("Enter 4-digit code (col,row,dir,dist): ")
    say dayzero_decode_str(code_input)
end

main()