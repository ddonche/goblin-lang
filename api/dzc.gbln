/// Day Zero Cipher Decoder (standalone)
/// Input: 4-digit code (col,row,dir,dist). Output: 4-letter result.

GRID = [
    ["V","P","W","J","T","R","I","D","G","B"],   /// row 1
    ["C","G","H","E","L","A","T","P","K","Z"],   /// row 2
    ["E","N","F","X","Y","Z","C","O","W","I"],   /// row 3
    ["Q","V","M","S","Q","X","U","G","L","S"],   /// row 4
    ["B","R","K","N","D","M","W","B","O","A"],   /// row 5
    ["Z","D","E","U","R","S","K","M","Q","Y"],   /// row 6
    ["F","A","J","Y","B","Z","H","T","N","L"],   /// row 7
    ["U","O","I","L","C","N","J","E","D","V"],   /// row 8
    ["P","Y","Q","H","F","U","V","W","J","R"]    /// row 9
]

/// direction vectors by index (dir 1..8 -> index 0..7)
DIRS = [
    [-1,  0],   /// 1 ↑
    [-1,  1],   /// 2 ↗
    [ 0,  1],   /// 3 →
    [ 1,  1],   /// 4 ↘
    [ 1,  0],   /// 5 ↓
    [ 1, -1],   /// 6 ↙
    [ 0, -1],   /// 7 ←
    [-1, -1]    /// 8 ↖
]

act in_bounds(row, col)
    return row >= 1 && row <= 9 && col >= 0 && col <= 9
end

act letter_at(row, col)
    r_index = int(row - 1)
    c_index = int(col)
    row_arr = GRID[r_index]
    return row_arr[c_index]
end

INF = 9999

act avail_axis(pos, delta, hi)
    if delta < 0
        return pos
    end
    if delta > 0
        return hi - pos
    end
    return INF
end

act room(row, col, dir)
    dv = DIRS[int(dir - 1)]
    dr = dv[0]
    dc = dv[1]

    /// row index is (row-1) in 0..8, col index is col in 0..9
    steps_r = avail_axis(row - 1, dr, 8)
    steps_c = avail_axis(col,     dc, 9)
    return min(steps_r, steps_c)
end

/// one step: try dir; if not enough room for 'dist', use opposite; clamp to available steps
act step(row, col, dir, dist)
    use_dir = dir
    if dist > room(row, col, dir)
        use_dir = ((dir + 3) % 8) + 1   /// 1↔5, 2↔6, …, 8↔4
    end

    steps = int(min(dist, room(row, col, use_dir)))

    dv = DIRS[int(use_dir - 1)]
    dr = dv[0]
    dc = dv[1]
    land_row = row + dr * steps
    land_col = col + dc * steps

    return [land_row, land_col, use_dir]
end

act dayzero_decode4(col, row, dir, dist)
    r = row
    c = col
    d = dir
    k = dist

    out = ""
    repeat 4
        stepres = step(r, c, d, k)
        r = stepres[0]
        c = stepres[1]
        out = out + letter_at(r, c)

        /// rotate direction clockwise (1→2→…→8→1)
        d = (d % 8) + 1
    end
    return out
end

/// ----- Minimal digit helper -----
DIGITS = "0123456789"

act dig_at(s, i)
    ch  = s[i:i+1]
    ix  = find(DIGITS, ch)
    if ix.is_nil
        return -1
    end
    return ix
end

act dayzero_decode_str(code)
    s = code + ""
    if len(s) != 4
        return "ERR"                               <--- wrong length
    end

    d0 = dig_at(s, 0)   <--- col 0..9 (assumed valid)
    d1 = dig_at(s, 1)   <--- row 1..9 (assumed valid)
    d2 = dig_at(s, 2)   <--- dir 1..8
    d3 = dig_at(s, 3)   <--- dist 1..4

    judge
        min(d0, d1, d2, d3) < 0: return "ERR"    <--- all must be digits
        d2 < 1 <> d2 > 8:       return "ERR"    <--- dir cannot be 0 or 9
        d3 < 1 <> d3 > 4:       return "ERR"    <--- dist limited to 1..4
    end

    return dayzero_decode4(d0, d1, d2, d3)
end

/// ---- entrypoint ----
act main
    code_input = ask("Enter 4-digit code (col,row,dir,dist): ")
    say dayzero_decode_str(code_input)
end

main()