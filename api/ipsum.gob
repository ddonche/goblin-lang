    "terribles ",
]

/// words that will appear to make it feel more smooth; prepositions
commons | [
    "the ", "and ", "in ", "under ", "over ", "through ", "with ", "from ", "above ", "if ",
    "of ", "a ", "this ", "that ", "little ", "old ", "hungry ", "loud ", "under ", "go ",
    "quiet ", "strange ", "broken ", "big ", "tiny ", "at ", "there ", "be ", "for ", "out ",
]

act goblin_ipsum_sentence
    /// generate random numbers of words from each list
    wc | pick 1 from 2...18 
    wc2 | pick 1 from 2...6  

    rest_words | pick {wc} from gbln_words with dups
    common_words | pick {wc2} from commons with dups

    all_words | rest_words + common_words 

    shuffled | shuffle(all_words)  
    
    /// capitalize the first word of each sentence
    shuffled[0] |! :title(shuffled[0])
    final | :pack(shuffled)
    final.trim + ". "
xx

act goblin_ipsum_paragraph
    sentence_count | pick 1 from 3...7
    sentences | []
    repeat sentence_count
        s | goblin_ipsum_sentence()
        put_last!(sentences, s)
    xx
    :pack(sentences)
xx

act goblin_ipsum
    /// while loop using bare repeat
    repeat
        para_count | :ask("How many paragraphs? (1-5)").int

        if (para_count >= 1) and (para_count <= 5)
            repeat para_count
                say goblin_ipsum_paragraph() + "\n"
            xx
        else
            say "Please enter a number between 1 and 5."
        xx
    xx
xx

goblin_ipsum()