act get_codename 
    repeat 50
        f = reap! 1 from adj 
        l = reap! 1 from noun
        cn = f ++ l
        num1 = pick 1 from 0...9
        num2 = pick 1 from 0...9 
        num3 = num1.str + num2.str
        say cn ++ num3
    end
end

get_codename()