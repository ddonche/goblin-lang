/// Define a blog system with users, posts, comments, and tags

@User =
    name: Str
    email: Str
    with Post
    with Comment
    re Role
end

@Role =
    name: Str
    re User
end

@Post =
    title: Str
    content: Str
    of User as author
    with Comment
    re Tag
end

@Comment =
    text: Str
    of User as commenter
    of Post as post
end

@Tag =
    name: Str
    re Post
end

/// Create users
alice|User = { name: "Alice", email: "alice@example.com" }
bob|User = { name: "Bob", email: "bob@example.com" }

say "=== Users created ==="
say alice >> name
say alice >> id
say bob >> name
say bob >> id

/// Create posts
post1|Post = { title: "First Post", content: "Hello World", author: alice }
post2|Post = { title: "Second Post", content: "More content", author: bob }
post3|Post = { title: "Another from Alice", content: "Back again", author: alice }

say "=== Posts created ==="
say post1 >> title
say post1 >> author_id
say post2 >> title
say post2 >> author_id
say post3 >> author_id

/// Create comments
comment1|Comment = { text: "Great post!", commenter: bob, post: post1 }
comment2|Comment = { text: "Thanks!", commenter: alice, post: post1 }
comment3|Comment = { text: "Interesting", commenter: alice, post: post2 }

say "=== Comments created ==="
say comment1 >> text
say comment1 >> commenter_id
say comment1 >> post_id
say comment2 >> commenter_id
say comment2 >> post_id

/// Verify foreign keys match
say "=== Verify relationships ==="
say "Comment 1 commenter is Bob?"
bob_match = (comment1 >> commenter_id) == (bob >> id)
say bob_match

say "Comment 1 is on Post 1?"
post1_match = (comment1 >> post_id) == (post1 >> id)
say post1_match

say "Comment 2 commenter is Alice?"
alice_match = (comment2 >> commenter_id) == (alice >> id)
say alice_match

say "Post 1 author is Alice?"
author1_match = (post1 >> author_id) == (alice >> id)
say author1_match

say "Post 2 author is Bob?"
author2_match = (post2 >> author_id) == (bob >> id)
say author2_match