@User = 
    id!: 0,
    name: "Default",
    email?: nil

    act greet
        say "Hello, " ++ name
    end
    
    act show_email
        say email ?? "No email provided"
    end
end

user1|User = { id: 1, name: "Alice", email: "alice@example.com" }
user1.greet
user1.show_email

user2|User = { id: 2, name: "Bob", email: nil }
user2.greet
user2.show_email

/// Test readonly - this should fail at runtime
user1 >> id = 999