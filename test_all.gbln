/// Test 1: Basic class with string interpolation and actions
@Person = name: "{name}", age: 25
    act greet()
        say "Hello, I'm {name} and I'm {age} years old"
    end
end

/// Test 2: Object instantiation with all values
alice|Person = { name: "Alice", age: 30 }

/// Test 3: Field access
alice >> name

/// Test 4: Method call
alice.greet()

/// Test 5: Field assignment
alice >> age = 31
alice.greet()

/// Test 6: Using default values (skipping age)
bob|Person = { name: "Bob" }
bob.greet()

/// Test 7: Class with numeric field and methods that access fields
@Counter = value: 0
    act increment()
        value = value + 1
    end
    
    act get()
        value
    end
end

/// Test 8: Object instantiation with single value
c|Counter = { value: 5 }

/// Test 9: Method that reads a field
say c.get()

/// Test 10: Method that modifies a field
c.increment()

/// Test 11: Verify field modification persisted
say c.get()

