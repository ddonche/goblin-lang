/// Test both import styles

/// Single path import
import game/hero

/// Grouped import
import { Combat } from game

say "=== Single path import ==="
knight = hero::generate()
say knight >> name

say "=== Grouped import ==="
dragon = { name: "Dragon", health: 200 }
Combat::fight(knight, dragon)

/// Test 1: Basic class with action
@User = 
    id!: 0,
    name: "Default",
    email?: nil
    
    act greet
        say "Hello, " ++ name
    end
end

user|User = { id: 1, name: "Alice", email: "alice@example.com" }
user.greet

/// Test 2: Full nullable and readonly test (final working version)
@User = 
    id!: 0,
    name: "Default",
    email?: nil
    act greet
        say "Hello, " ++ name
    end
    
    act show_email
        say email ?? "No email provided"
    end
end

user1|User = { 1, "Alice", "alice@example.com" }
user1.greet
user1.show_email

user2|User = { id: 2, name: "Bob", email: nil }
user2.greet
user2.show_email

/// Test readonly - this should fail at runtime
/// user1 >> id = 999

