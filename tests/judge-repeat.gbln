act test_it(building_type)
  items = []
  
  judge
    building_type == "Warrior": ["sword", "shield", "armor"]
    building_type == "Mage":    ["staff", "robe", "spellbook"]
    else: ["stick"]
  end
end

result = test_it("Warrior")
say result

command = "look"
judge using command
  "look": say "You look around"
  "go": say "You go somewhere"
  "help": say "Help text"
  else: say "Unknown command"
end