    ~militancy: .5
    ~margin: .08

    transition split where (self >> loyalty) < .5 and (self >> greed) > .8 and (self >> influence) > .75
        into: Faction, Faction
        first:
            loyalty:   (self >> loyalty)
            greed:     (self >> greed)
            influence: (self >> influence) * .6
            militancy: (self >> militancy) + .1
            margin:    (self >> margin)
        xx
        second:
            loyalty:   (self >> loyalty) + .1
            greed:     (self >> greed) * .7
            influence: (self >> influence) * .4
            militancy: (self >> militancy) * .8
            margin:    (self >> margin)
        xx
        overlays: split
        links: reset
    xx

    transition mutate where (self >> militancy) > .82 and (self >> loyalty) < .72 and (self >> influence) > .7
        into: Faction
        carries:
            loyalty:   .2
            greed:     (self >> greed) + .1
            influence: (self >> influence) * .8
            militancy: 1
            margin:    (self >> margin)
        xx
        overlays: transfer
        links: reset
    xx

    transition absorb
        targets: Faction where (self >> influence) > (target >> influence) * 2.4 and (self >> greed) > .85
        carries:
            loyalty:   (self >> loyalty) - .05
            greed:     (self >> greed)
            influence: (self >> influence) + (target >> influence) * .6
            militancy: (self >> militancy)
            margin:    (self >> margin)
        xx
        overlays: transfer
        links: inherit
    xx

    transition subjugate
        targets: Faction where (self >> influence) > (target >> influence) * 2.1 and (self >> militancy) > .85
        overlays: transfer
        links: inherit
    xx
end

