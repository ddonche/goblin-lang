:overlay!(Valedawn, sylvaris_tongue, .03)

:overlay!(Nerezza, nerezza_tongue, .95)
:overlay!(Sylvaris, nerezza_tongue, .05)
:overlay!(Valedawn, nerezza_tongue, .04)

:overlay!(Aurelion, solar_creed_faith, .8)
:overlay!(Valedawn, solar_creed_faith, .5)
:overlay!(Sylvaris, root_pact_faith, .9)
:overlay!(Nerezza, root_pact_faith, .5)
:overlay!(Drakmoor, ashen_rite_faith, .8)
:overlay!(Kharum, ashen_rite_faith, .7)

:say "=== Memory Starting ==="
:say :mem_human()

repeat 300
    :tick()

    repeat :objects(it>>kind == "polity")
        population_pressure(it)

        chance | pick 1 from 1...1000
        if chance > 975
            event(it)
        end
    xx
end

:say "=== Memory Ending ==="
:say :mem_human()

:say "=== POLITIES ==="
repeat :objects(it>>kind == "polity")
    :say it
xx

:say "=== FACTIONS ==="
repeat factions
    :say it
xx

:say "=== ALL OVERLAYS ==="
repeat :overlays()
    :say it
xx