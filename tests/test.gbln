act event(target)
    events | [
        "plague",
        "famine",
        "NaturalDisaster",
        "depression",
        "religious_schism",
        "succession_crisis",
        "MigrationWave",
        "TradeCollapse",
        "CivilUnrest",
        "GoldenAge",
        "DragonRaid",
        "UndeadSurge",
        "WyrmHunger"
    ]

    picked | :get_random(events)
    severity | (pick 1 from 5...25) * .01

    if picked == "plague"
        :overlay!(target, plague, .2, 6)
        target >> fear |= target >> fear + (severity * .5)
    end

    if picked == "famine"
        :overlay!(target, famine, .06, 5)
        target >> aggression |= target >> aggression + (severity * .06)
    end

    if picked == "NaturalDisaster"
        target >> population |= target >> population - ((target >> population) * (severity * .3))
        target >> gold |= target >> gold - (target >> gold * severity)
        target >> stone |= target >> stone - (target >> stone * severity)
        target >> stability |= target >> stability - (severity * .5)
        target >> fear |= target >> fear + (severity * .4)
    end

    if picked == "depression"
        target >> gold |= target >> gold - (target >> gold * (severity * 2))
        target >> cooperation |= target >> cooperation - (severity * .4)
        target >> stability |= target >> stability - (severity * .5)
        target >> fear |= target >> fear + (severity * .6)
        target >> ambition |= target >> ambition + (severity * .2)
    end

    if picked == "religious_schism"
        target >> cohesion |= target >> cohesion - (severity * .7)
        target >> spirituality |= target >> spirituality + (severity * .4)
        target >> openness |= target >> openness - (severity * .5)
        target >> fear |= target >> fear + (severity * .3)
    end

    if picked == "succession_crisis"
        :overlay!(target, succession_crisis, .2, 8)
        target >> ambition |= target >> ambition + (severity * .3)
    end

    if picked == "MigrationWave"
        target >> population |= target >> population + ((target >> population) * severity)
        target >> openness |= target >> openness + (severity * .5)
        target >> cohesion |= target >> cohesion - (severity * .3)
        target >> food |= target >> food - (target >> food * severity)
    end

    if picked == "TradeCollapse"
        target >> gold |= target >> gold - (target >> gold * (severity * 2))
        target >> openness |= target >> openness - (severity * .6)
        target >> cooperation |= target >> cooperation - (severity * .5)
        target >> fear |= target >> fear + (severity * .3)
        target >> discipline |= target >> discipline + (severity * .2)
    end

    if picked == "CivilUnrest"
        :overlay!(target, rebellion, .2, 10)
        target >> fear |= target >> fear + (severity * .3)
    end

    if picked == "GoldenAge"
        target >> gold |= target >> gold + (target >> gold * severity)
        target >> stability |= target >> stability + (severity * .5)
        target >> cooperation |= target >> cooperation + (severity * .4)
        target >> openness |= target >> openness + (severity * .4)
        target >> ambition |= target >> ambition + (severity * .3)
    end

    if picked == "DragonRaid"
        target >> fear |= target >> fear + (severity * .6)
        target >> stability |= target >> stability - (severity * .3)
        target >> food |= target >> food - (target >> food * severity)
        target >> horses |= target >> horses - (target >> horses * severity)
        target >> population |= target >> population - ((target >> population) * (severity * .1))
    end

    if picked == "UndeadSurge"
        target >> fear |= target >> fear + (severity * .7)
        target >> stability |= target >> stability - (severity * .4)
        target >> population |= target >> population - ((target >> population) * (severity * .15))
        target >> cohesion |= target >> cohesion - (severity * .3)
        target >> succession |= target >> succession - (severity * .2)
    end

    if picked == "WyrmHunger"
        target >> fear |= target >> fear + (severity * .5)
        target >> food |= target >> food - (target >> food * (severity * 1.5))
        target >> population |= target >> population - ((target >> population) * (severity * .12))
        target >> stability |= target >> stability - (severity * .25)
    end
end

act population_pressure(target)
    if :is_nil(target) == false
        if (target >> population) > 0
            farm_output | ((target >> population) * .00031) * (.55 + (((target >> stability) + (target >> cohesion) + (target >> discipline)) * .14))
            food_need | (target >> population) * .00022

            target >> food |= target >> food + farm_output

            if (target >> food) > food_need
                target >> food |= target >> food - food_need
                target >> fear |= target >> fear - .0012
                target >> stability |= target >> stability + (((target >> cohesion) + (target >> discipline)) * .0012)
            else
                food_shortage | food_need - (target >> food)
                target >> food |= 0
                target >> population |= target >> population - (food_shortage * 18)
                target >> fear |= target >> fear + (food_shortage * .000035)
                target >> stability |= target >> stability - (food_shortage * .000025)
                target >> cohesion |= target >> cohesion - (food_shortage * .000018)

                if (target >> discipline) > .45
                    target >> discipline |= target >> discipline + .006
                    target >> cohesion |= target >> cohesion + .003
                    target >> openness |= target >> openness - .004
                end

                if (target >> cooperation) > .6
                    target >> aggression |= target >> aggression - .006
                    target >> ambition |= target >> ambition - .004
                end
            end
        end

        wood_use | (target >> population) * .000002
        if (target >> wood) > wood_use
            target >> wood |= target >> wood - wood_use
        else
            wood_shortage | wood_use - (target >> wood)
            target >> wood |= 0
            target >> stability |= target >> stability - (wood_shortage * .000025)
            target >> cohesion |= target >> cohesion - (wood_shortage * .000018)
            target >> fear |= target >> fear + (wood_shortage * .000018)
        end

        mana_drift | (target >> spirituality) * (pick 1 from 1...4)
        target >> mana |= target >> mana + mana_drift

        iron_drift | (target >> discipline) * (pick 1 from 1...3)
        target >> iron |= target >> iron + iron_drift

        target >> stability |= target >> stability + (((target >> cohesion) + (target >> discipline)) * .002)
        target >> cohesion |= target >> cohesion + (((target >> stability) + (target >> honor)) * .0016)
        target >> succession |= target >> succession + (((target >> stability) + (target >> honor)) * .0016)

        target >> ambition |= target >> ambition + ((target >> gold) * .000001)
        target >> ambition |= target >> ambition + ((target >> population) * .0000000015)
        target >> ambition |= target >> ambition - ((target >> stability) * .0015)

        target >> cooperation |= target >> cooperation - ((target >> ambition) * .0007)
        target >> cohesion |= target >> cohesion - ((target >> openness) * .0006)
        target >> openness |= target >> openness - ((target >> discipline) * .0008)
        target >> spirituality |= target >> spirituality - ((target >> discipline) * .0006)
        target >> discipline |= target >> discipline - ((target >> cooperation) * .00045)

        target >> fear |= target >> fear - ((target >> stability) * .003)
        target >> aggression |= target >> aggression + ((target >> fear) * .00035)
        target >> aggression |= target >> aggression + ((target >> ambition) * .00025)
        target >> aggression |= target >> aggression - ((target >> cooperation) * .0018)

        if (target >> food) > 700
            target >> population |= target >> population + (((target >> stability) + (target >> cohesion)) * (pick 1 from 80...260))
            target >> stability |= target >> stability + ((target >> cohesion) * .0015)
            target >> fear |= target >> fear - .0012
            target >> aggression |= target >> aggression - .003
        end

        if (target >> population) > 850000
            target >> cohesion |= target >> cohesion - .0015
            target >> stability |= target >> stability - .0008
            target >> ambition |= target >> ambition + .0015
        end

        if (target >> gold) > 850
            target >> ambition |= target >> ambition + .0008
            target >> honor |= target >> honor - .0008
            target >> stability |= target >> stability + .001
            target >> cooperation |= target >> cooperation + .0008
        end

        if (target >> fear) > .75 and (target >> discipline) > .45
            target >> discipline |= target >> discipline + .006
            target >> cohesion |= target >> cohesion + .004
            target >> openness |= target >> openness - .004
            target >> aggression |= target >> aggression - .004
        end

        if (target >> fear) > .75 and (target >> discipline) < .25
            target >> stability |= target >> stability - .006
            target >> cohesion |= target >> cohesion - .006
            target >> aggression |= target >> aggression + .004
        end

        if (target >> population) < 50000
            target >> fear |= target >> fear + .012
            target >> stability |= target >> stability - .01
            target >> succession |= target >> succession - .012
            target >> power |= target >> power - .008
            target >> ambition |= target >> ambition - .006
        end

        border_fear | ((target >> aggression) * .0025) + ((1 - (target >> stability)) * .003) + ((1 - (target >> succession)) * .002)
        target >> fear |= target >> fear + border_fear

        if (target >> openness) < .25 and (target >> aggression) > .7
            target >> fear |= target >> fear + .006
        end

        if (target >> cohesion) < .35
            target >> fear |= target >> fear + .006
        end

        if (target >> succession) < .35
            target >> fear |= target >> fear + .008
        end

        if (target >> power) < .35
            target >> fear |= target >> fear + .006
        end

        if (target >> stability) > .85 and (target >> cohesion) > .7 and (target >> food) > 600
            target >> fear |= target >> fear - .002
        end


        if (target >> openness) > .75 and (target >> spirituality) < .45
            target >> spirituality |= target >> spirituality - .006
            target >> cohesion |= target >> cohesion - .003
            target >> cooperation |= target >> cooperation + .003
        end

        if (target >> spirituality) > .8 and (target >> openness) < .35 and (target >> fear) > .45
            target >> openness |= target >> openness - .006
            target >> discipline |= target >> discipline + .004
            target >> fear |= target >> fear + .004
        end

        if (target >> openness) > .65 and (target >> spirituality) > .65
            target >> cooperation |= target >> cooperation + .003
            target >> cohesion |= target >> cohesion - .002
        end

        target >> power |= ((target >> population) * .0000015) + ((target >> food) * .00008) + ((target >> gold) * .00012) + ((target >> iron) * .00004) + ((target >> horses) * .0008) + ((target >> discipline) * .22) + ((target >> stability) * .18) + ((target >> cohesion) * .12)
    end
end

<>Empire |
    kind: "polity"
    ~aggression: .75
    ~cooperation: .35
    ~fear: .45
    ~ambition: .85
    ~cohesion: .65
    ~stability: .65
    ~succession: .45
    ~honor: .45
    ~spirituality: .35
    ~openness: .25
    ~discipline: .85
    ~power: .7
    population: 400000
    gold: 300
    food: 800
    iron: 500
    mana: 100
    wood: 250
    horses: 80
    stone: 250
    relics: 4
    ships: 10
    ~margin: .09

    transition absorb
        targets: Kingdom where (self >> power) > (target >> power) * 1.8 and (target >> population) < 50000 and (target >> stability) < .35
        carries:
            aggression: self >> aggression + ((target >> fear) * .04)
            cooperation: self >> cooperation - ((target >> fear) * .03)
            fear: self >> fear + ((target >> fear) * .08)
            ambition: self >> ambition + ((target >> ambition) * .03)
            cohesion: self >> cohesion - .02
            stability: self >> stability - ((target >> fear) * .04)
            succession: self >> succession - ((target >> succession) * .03)
            honor: self >> honor - .015
            spirituality: self >> spirituality
            openness: self >> openness
            discipline: self >> discipline + .01
            power: self >> power + (target >> power * .18)
            population: self >> population + target >> population
