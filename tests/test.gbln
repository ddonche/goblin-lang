    modify
        @openness + .001
        @cooperation + .0005
    xx
    /// Past a strength, it starts another overlay on its host (once).
    every 1 tick
        if intensity > .18 and :len(:overlays(self, aurelian_dialect)) == 0
            :overlay!(self, aurelian_dialect, .035)
        xx
    xx
