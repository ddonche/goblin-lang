<>Kingdom |
    kind: "polity"
    ~aggression: .5
    ~cooperation: .5 <---- this is a fucking inline comment
    ~fear: .5
    ~ambition: .5

    ~cohesion: .5
    ~stability: .5
    ~succession: .5

    ~honor: .5
    ~spirituality: .5
    ~openness: .5
    ~discipline: .5
    ~power: .5

    population: 500000

    gold: 500
    food: 500
    iron: 300
    mana: 100
    wood: 300
    horses: 100
    stone: 250
    relics: 10
    ships: 20

    ~margin: .08

    act trade(target)
        resources | ["gold", "food", "iron", "mana", "wood", "horses", "stone", "relics", "ships"]

        self_resource | :get_random(:get_where(resources, self >> item > 140))
        target_resource | :get_random(:get_where(resources, target >> item > 140))

        self_gives | ((self >> cooperation) + (self >> openness) + (self >> discipline)) * (pick 1 from 1...4)
        target_gives | ((target >> cooperation) + (target >> openness) + (target >> discipline)) * (pick 1 from 1...4)

        if (self >> self_resource) > self_gives and (target >> target_resource) > target_gives
            self >> self_resource |= self >> self_resource - self_gives
            target >> self_resource |= target >> self_resource + self_gives

            target >> target_resource |= target >> target_resource - target_gives
            self >> target_resource |= self >> target_resource + target_gives

            self >> cooperation |= self >> cooperation + .004
            target >> cooperation |= target >> cooperation + .004

            self >> openness |= self >> openness + .0025
            target >> openness |= target >> openness + .0025

            self >> cohesion |= self >> cohesion - ((self >> openness) * .001)
            target >> cohesion |= target >> cohesion - ((target >> openness) * .001)

            self >> discipline |= self >> discipline - ((self >> cooperation) * .0008)
            target >> discipline |= target >> discipline - ((target >> cooperation) * .0008)

            self >> stability |= self >> stability + ((self >> cooperation) * .002)
            target >> stability |= target >> stability + ((target >> cooperation) * .002)

            self >> fear |= self >> fear - ((self >> cooperation) * .002)
            target >> fear |= target >> fear - ((target >> cooperation) * .002)

            if (self >> spirituality) > .7
                :overlay!(target, root_pact_faith, .004, 10)
            end
        else
            self >> ambition |= self >> ambition - .004
            self >> fear |= self >> fear + .003
            self >> cooperation |= self >> cooperation - .003
        end

    end

    act treaty(target)
        treaty_strength | (self >> cooperation) + (target >> cooperation) + (self >> honor) + (target >> honor)

        self >> stability |= self >> stability + (treaty_strength * .015)
        target >> stability |= target >> stability + (treaty_strength * .015)

        self >> fear |= self >> fear - (treaty_strength * .03)
        target >> fear |= target >> fear - (treaty_strength * .03)

        self >> cooperation |= self >> cooperation + .012
        target >> cooperation |= target >> cooperation + .012

        self >> aggression |= self >> aggression - (treaty_strength * .012)
        target >> aggression |= target >> aggression - (treaty_strength * .012)

        self >> ambition |= self >> ambition + .002
        target >> ambition |= target >> ambition + .002

        self >> discipline |= self >> discipline - .003
        target >> discipline |= target >> discipline - .003

        self >> honor |= self >> honor - .004
        target >> honor |= target >> honor - .004

        self >> succession |= self >> succession + ((self >> stability) * .006)
        target >> succession |= target >> succession + ((target >> stability) * .006)


        self >> ambition |= self >> ambition - ((self >> stability) * .002)
        target >> ambition |= target >> ambition - ((target >> stability) * .002)

        :link!(self, target, culture, .03, 12)
        :link!(target, self, culture, .03, 12)

        :link!(self, target, trade, .04, 12)
        :link!(target, self, trade, .04, 12)

    end

    act aid(target)
        resources | ["gold", "food", "wood", "stone", "mana"]

        aid_resource | :get_random(:get_where(resources, self >> item > 120))

        aid_amount | ((self >> cooperation) + (self >> honor)) * (pick 1 from 3...10)

        self >> aid_resource |= self >> aid_resource - aid_amount
        target >> aid_resource |= target >> aid_resource + aid_amount

        target >> stability |= target >> stability + .025
        target >> cohesion |= target >> cohesion + .02
        target >> fear |= target >> fear - .01

        self >> honor |= self >> honor + .012
        self >> fear |= self >> fear + .004
        self >> ambition |= self >> ambition + .004
        self >> stability |= self >> stability - .008
        self >> discipline |= self >> discipline - .004
        self >> cooperation |= self >> cooperation + .006

        target >> ambition |= target >> ambition + .004
        target >> cooperation |= target >> cooperation + .006

        :link!(self, target, culture, .03, 10)

    end

    act denounce(target)
        pressure | ((self >> aggression) + (self >> fear)) * (pick 1 from .01....03)

        target >> stability |= target >> stability - pressure
        target >> cohesion |= target >> cohesion - (pressure * .5)
        target >> fear |= target >> fear + (pressure * .6)
        target >> aggression |= target >> aggression + (pressure * .4)

        self >> aggression |= self >> aggression + .006
        self >> honor |= self >> honor - .005
        self >> cooperation |= self >> cooperation - .004
        self >> openness |= self >> openness - .003
        self >> fear |= self >> fear + .004
        self >> discipline |= self >> discipline + .003

        target >> cooperation |= target >> cooperation - .004
        target >> honor |= target >> honor + .003

        :link!(self, target, border, .02, 8)

    end

    act raid(target)
        resources | ["gold", "food", "iron", "wood", "horses", "stone"]

        stolen_resource | :get_random(:get_where(resources, target >> item > 50))

        raid_power | (self >> aggression) + (self >> ambition) + (self >> discipline)
        defense_power | (target >> discipline) + (target >> cohesion) + (target >> stability)

        raid_amount | (raid_power - defense_power) * (pick 1 from 10...35)
        casualties | (raid_power + defense_power) * (pick 1 from 80...240)

        if raid_amount > 0
            target >> stolen_resource |= target >> stolen_resource - raid_amount
            self >> stolen_resource |= self >> stolen_resource + raid_amount
        end

        self >> population |= self >> population - (casualties * .3)
        target >> population |= target >> population - casualties

        self >> ambition |= self >> ambition + .008
        self >> aggression |= self >> aggression + .005
        self >> honor |= self >> honor - .01
        self >> cooperation |= self >> cooperation - .004

        target >> fear |= target >> fear + .025
        target >> cohesion |= target >> cohesion - .015
        target >> aggression |= target >> aggression + .008
        target >> cooperation |= target >> cooperation - .006
        target >> honor |= target >> honor + .004

        self >> discipline |= self >> discipline + .004
        self >> stability |= self >> stability - .006
        self >> fear |= self >> fear + .004

        :overlay!(self, war_weariness, .12, 6)
        :overlay!(target, war_weariness, .22, 8)

        if (target >> food) < 150
            :overlay!(target, famine, .06, 5)
            :overlay!(target, famine_memory, .05, 20)
        end

        if (self >> spirituality) > .6
            :overlay!(target, ashen_rite_faith, .008, 10)
        end

        self >> power |= ((self >> population) * .0000015) + ((self >> food) * .00008) + ((self >> gold) * .00012) + ((self >> iron) * .00004) + ((self >> horses) * .0008) + ((self >> discipline) * .22) + ((self >> stability) * .18) + ((self >> cohesion) * .12)
        target >> power |= ((target >> population) * .0000015) + ((target >> food) * .00008) + ((target >> gold) * .00012) + ((target >> iron) * .00004) + ((target >> horses) * .0008) + ((target >> discipline) * .22) + ((target >> stability) * .18) + ((target >> cohesion) * .12)

    end

    act strike(target)
        strike_power | (self >> aggression) + (self >> discipline) + (self >> ambition)
        defense_power | (target >> discipline) + (target >> cohesion)

        iron_cost | strike_power * (pick 1 from 8...18)
        food_cost | strike_power * (pick 1 from 5...14)
        horse_cost | strike_power * (pick 1 from 1...5)
        wood_cost | strike_power * (pick 1 from 4...12)

        if (self >> iron) > iron_cost and (self >> food) > food_cost and (self >> horses) > horse_cost and (self >> wood) > wood_cost
            casualties | (strike_power + defense_power) * (pick 1 from 150...420)

            self >> iron |= self >> iron - iron_cost
            self >> food |= self >> food - food_cost
            self >> horses |= self >> horses - horse_cost
            self >> wood |= self >> wood - wood_cost

            self >> population |= self >> population - (casualties * .4)
            self >> fear |= self >> fear + .015
            self >> honor |= self >> honor - .012
            self >> cooperation |= self >> cooperation - .006

            target >> population |= target >> population - casualties
            target >> stability |= target >> stability - .04
            target >> cohesion |= target >> cohesion - .015
            target >> fear |= target >> fear + .04
            target >> aggression |= target >> aggression + .01
            target >> cooperation |= target >> cooperation - .008
            target >> honor |= target >> honor + .006

            self >> discipline |= self >> discipline + .006
            self >> stability |= self >> stability - .01
            self >> ambition |= self >> ambition + .006

            :overlay!(self, war_weariness, .18, 8)
            :overlay!(target, war_weariness, .3, 10)

            if (target >> food) < 150
                :overlay!(target, famine, .08, 6)
            end
        else
            self >> fear |= self >> fear + .012
            self >> aggression |= self >> aggression - .01
            self >> ambition |= self >> ambition - .008
            self >> discipline |= self >> discipline - .006
            self >> stability |= self >> stability - .006
            self >> cohesion |= self >> cohesion - .004
        end
    end

    act invade(target)
        invasion_power | (self >> aggression) + (self >> ambition) + (self >> discipline) + (self >> cohesion)
        defense_power | (target >> discipline) + (target >> cohesion) + (target >> stability)

        iron_cost | pick 1 from 15...45
        food_cost | pick 1 from 12...36
        horse_cost | pick 1 from 2...8
        wood_cost | pick 1 from 20...60

        if (self >> iron) > iron_cost and (self >> food) > food_cost and (self >> horses) > horse_cost and (self >> wood) > wood_cost
            plunder_resource | :get_random(:get_where(["gold", "food", "iron", "wood", "stone"], target >> item > 100))

            plunder | (invasion_power - defense_power) * (pick 1 from 25...80)
            casualties | (invasion_power + defense_power) * (pick 1 from 400...1200)

            self >> iron |= self >> iron - iron_cost
            self >> food |= self >> food - food_cost
            self >> horses |= self >> horses - horse_cost
            self >> wood |= self >> wood - wood_cost

            if plunder > 0
                target >> plunder_resource |= target >> plunder_resource - plunder
                self >> plunder_resource |= self >> plunder_resource + plunder
            end

            self >> population |= self >> population - (casualties * .5)
            self >> honor |= self >> honor - .02
            self >> cooperation |= self >> cooperation - .015
            self >> fear |= self >> fear + .02
            self >> ambition |= self >> ambition + .01

            target >> population |= target >> population - casualties
            target >> stability |= target >> stability - .08
            target >> cohesion |= target >> cohesion - .05
            target >> succession |= target >> succession - .03
            target >> fear |= target >> fear + .06
            target >> aggression |= target >> aggression + .015
            target >> cooperation |= target >> cooperation - .012
            target >> honor |= target >> honor + .008
            target >> spirituality |= target >> spirituality + .006

            self >> discipline |= self >> discipline + .008
            self >> stability |= self >> stability - .018
            self >> cohesion |= self >> cohesion - .012
            self >> succession |= self >> succession - .008

            :overlay!(self, war_weariness, .3, 12)
            :overlay!(target, war_weariness, .45, 14)
            :overlay!(target, rebellion, .15, 10)

            if (target >> food) < 200
                :overlay!(target, famine, .1, 6)
            end

            if (target >> succession) < .35
                :overlay!(target, succession_crisis, .3, 10)
            end

            self >> spirituality |= self >> spirituality + .01
            target >> spirituality |= target >> spirituality - .01

            if (self >> spirituality) > .5
                :overlay!(target, ashen_rite_faith, .012, 12)
            end

            self >> power |= ((self >> population) * .0000015) + ((self >> food) * .00008) + ((self >> gold) * .00012) + ((self >> iron) * .00004) + ((self >> horses) * .0008) + ((self >> discipline) * .22) + ((self >> stability) * .18) + ((self >> cohesion) * .12)
            target >> power |= ((target >> population) * .0000015) + ((target >> food) * .00008) + ((target >> gold) * .00012) + ((target >> iron) * .00004) + ((target >> horses) * .0008) + ((target >> discipline) * .22) + ((target >> stability) * .18) + ((target >> cohesion) * .12)
        else
            self >> fear |= self >> fear + .018
            self >> aggression |= self >> aggression - .012
            self >> ambition |= self >> ambition - .01
            self >> discipline |= self >> discipline - .008
            self >> stability |= self >> stability - .008
            self >> cohesion |= self >> cohesion - .006
        end
    end

    act spy(target)
        infiltration | ((self >> discipline) + (self >> openness)) * (pick 1 from .01....04)

        target >> fear |= target >> fear + infiltration
        target >> succession |= target >> succession - (infiltration * .5)
        target >> openness |= target >> openness - (infiltration * .25)
        target >> cooperation |= target >> cooperation - (infiltration * .2)

        self >> discipline |= self >> discipline + .006
        self >> ambition |= self >> ambition + .004
        self >> honor |= self >> honor - .005
        self >> openness |= self >> openness - .003
        self >> discipline |= self >> discipline + .006
        self >> cooperation |= self >> cooperation - .003

    end

    act bless(target)
        mana_cost | ((self >> spirituality) + (self >> honor)) * (pick 1 from 8...24)

        if (self >> mana) > mana_cost
            self >> mana |= self >> mana - mana_cost
            self >> spirituality |= self >> spirituality + .008
            self >> honor |= self >> honor + .006
            self >> discipline |= self >> discipline - .004
            self >> ambition |= self >> ambition + .003

            target >> stability |= target >> stability + .015
            target >> cohesion |= target >> cohesion + .025
            target >> spirituality |= target >> spirituality + .015
            target >> fear |= target >> fear - .015
            target >> openness |= target >> openness - .006
            target >> discipline |= target >> discipline - .005
            target >> openness |= target >> openness - ((target >> spirituality) * .004)
            target >> cohesion |= target >> cohesion + ((target >> spirituality) * .006)

            self >> openness |= self >> openness - ((self >> spirituality) * .004)
            self >> cohesion |= self >> cohesion + ((self >> spirituality) * .004)

            :overlay!(target, religious_fervor, .2, 8)

            if (self >> spirituality) > .7
                self >> honor |= self >> honor + .005
                :overlay!(target, solar_creed_faith, .01, 12)
            end

            if (self >> relics) > 5
                self >> relics |= self >> relics - 1
                self >> stability |= self >> stability + .02
                self >> spirituality |= self >> spirituality + .01
            end
        else
            self >> fear |= self >> fear + .008
            self >> spirituality |= self >> spirituality - .006
            self >> honor |= self >> honor - .004
        end
    end

    act curse(target)
        corruption_power | ((self >> aggression) + (self >> spirituality)) * (pick 1 from .01....05)
        mana_cost | ((self >> aggression) + (self >> spirituality)) * (pick 1 from 10...28)

        if (self >> mana) > mana_cost
            self >> mana |= self >> mana - mana_cost
            self >> honor |= self >> honor - .012
            self >> cooperation |= self >> cooperation - .008
            self >> openness |= self >> openness - .006
            self >> fear |= self >> fear + .005

            target >> stability |= target >> stability - corruption_power
            target >> fear |= target >> fear + (corruption_power * .8)
            target >> succession |= target >> succession - (corruption_power * .5)
            target >> cohesion |= target >> cohesion - (corruption_power * .4)
            target >> ambition |= target >> ambition + (corruption_power * .3)
            target >> honor |= target >> honor - (corruption_power * .4)
            target >> cooperation |= target >> cooperation - (corruption_power * .3)

            self >> spirituality |= self >> spirituality + .004
            self >> discipline |= self >> discipline - .003

            :overlay!(target, corruption, .25, 10)

            if (target >> succession) < .35
                :overlay!(target, succession_crisis, .25, 8)
            end
        else
            self >> fear |= self >> fear + .008
            self >> aggression |= self >> aggression - .006
            self >> spirituality |= self >> spirituality - .004
        end
    end

    act govern(target)
        if (self >> food) < 80
            self >> discipline |= self >> discipline + .012
            self >> openness |= self >> openness - .01
            self >> aggression |= self >> aggression - .012
            self >> ambition |= self >> ambition - .01
            self >> fear |= self >> fear + .006

            if (self >> cooperation) > .6
                self >> stability |= self >> stability + .006
                self >> cohesion |= self >> cohesion + .004
                self >> cooperation |= self >> cooperation - .003
            end

            if (self >> spirituality) > .6
                self >> cohesion |= self >> cohesion + .006
                self >> fear |= self >> fear - .004
                self >> openness |= self >> openness - .004
            end
        else
            self >> stability |= self >> stability + ((self >> discipline) * .003)
            self >> cohesion |= self >> cohesion + ((self >> honor) * .003)
            self >> succession |= self >> succession + ((self >> stability) * .003)
            self >> fear |= self >> fear - ((self >> stability) * .003)
            self >> ambition |= self >> ambition - ((self >> stability) * .0015)

            self >> openness |= self >> openness - ((self >> discipline) * .001)
            self >> discipline |= self >> discipline + ((self >> fear) * .002)

            if (self >> cooperation) > .75
                self >> cohesion |= self >> cohesion - .004
                self >> openness |= self >> openness + .003
            end

            if (self >> aggression) > .75
                self >> stability |= self >> stability - .003
                self >> cohesion |= self >> cohesion - .003
                self >> discipline |= self >> discipline - .002
            end
        end
    end

    /// The rival this kingdom deals with, and how hard: the score picks the deed.
    decision rival
        targets: Kingdom
        score => (
            self >> aggression * .14
            + self >> ambition * .12
            + self >> fear * .04
            + self >> spirituality * .04

            + (self >> aggression * .25 + self >> fear * .2 + self >> ambition * .15 + target >> aggression * .2 - self >> cooperation * .15 - target >> cooperation * .05) * .12

            - (self >> cooperation * .3 + self >> openness * .25 + target >> cooperation * .25 + target >> openness * .15 - self >> fear * .05) * .12
            - (self >> openness * .25 + target >> openness * .25 + self >> spirituality * .15 + target >> spirituality * .15 + self >> honor * .1 + target >> honor * .1) * .10

            - self >> cooperation * .12
            - self >> honor * .1
            - self >> stability * .12
            - self >> cohesion * .1

            + ((100 - (self >> food)) * .004)
            + ((100 - (self >> gold)) * .003)

            - ((1 - (self >> stability)) * .25)
            - ((1 - (self >> cohesion)) * .22)

            - ((1 - (self >> discipline)) * .15)

            - (self >> fear * .12)

            + ((target >> stability) * .06)
            + ((1 - (target >> cohesion)) * .05)
            + ((self >> food) * .00002)
            + ((self >> gold) * .00002)
        )
    xx
    judge
        rival and (rival >> score) >= .96: self.invade(rival >> target)
        rival and (rival >> score) >= .82: self.strike(rival >> target)
        rival and (rival >> score) >= .64: self.raid(rival >> target)
        rival and (rival >> score) >= .5: self.curse(rival >> target)
        rival and (rival >> score) >= .42: self.spy(rival >> target)
        rival and (rival >> score) >= .32: self.denounce(rival >> target)
        rival and (rival >> score) >= .22: self.bless(rival >> target)
        rival and (rival >> score) >= .16: self.aid(rival >> target)
        rival and (rival >> score) >= .1: self.treaty(rival >> target)
        rival and (rival >> score) >= .04: self.trade(rival >> target)
        rival: self.govern(rival >> target)
    xx

    transition absorb
        targets: Kingdom where (self >> power) > (target >> power) * 1.8 and (target >> population) < 50000 and (target >> stability) < .35
        carries:
            aggression: self >> aggression + ((target >> fear) * .04)
            cooperation: self >> cooperation - ((target >> fear) * .03)
            fear: self >> fear + ((target >> fear) * .08)
            ambition: self >> ambition + ((target >> ambition) * .03)
            cohesion: self >> cohesion - ((target >> population) * .00000002)
            stability: self >> stability - ((target >> fear) * .04)
            succession: self >> succession - ((target >> succession) * .03)
            honor: self >> honor - .015
            spirituality: self >> spirituality
            openness: self >> openness
            discipline: self >> discipline + .01
            power: self >> power + (target >> power * .18)
            population: self >> population + target >> population
            gold: self >> gold + target >> gold
            food: self >> food + (target >> food * .65)
            iron: self >> iron + (target >> iron * .65)
            mana: self >> mana + (target >> mana * .5)
            wood: self >> wood + (target >> wood * .65)
            horses: self >> horses + (target >> horses * .65)
            stone: self >> stone + (target >> stone * .65)
            relics: self >> relics + target >> relics
            ships: self >> ships + target >> ships
            margin: self >> margin + .01
        xx
        overlays: transfer
        links: inherit
    xx

    transition absorb
        targets: WarlordState where (self >> power) > (target >> power) * 1.6 and (target >> population) < 75000
        carries:
            aggression: self >> aggression + .025
            cooperation: self >> cooperation - .025
            fear: self >> fear + ((target >> fear) * .08)
            ambition: self >> ambition + .02
            cohesion: self >> cohesion - .025
            stability: self >> stability - .03
            succession: self >> succession - .015
            honor: self >> honor - .02
            spirituality: self >> spirituality
            openness: self >> openness - .01
            discipline: self >> discipline + .02
            power: self >> power + (target >> power * .15)
            population: self >> population + target >> population
            gold: self >> gold + target >> gold
            food: self >> food + (target >> food * .5)
            iron: self >> iron + (target >> iron * .6)
            mana: self >> mana + (target >> mana * .4)
            wood: self >> wood + (target >> wood * .5)
            horses: self >> horses + (target >> horses * .6)
            stone: self >> stone + (target >> stone * .5)
            relics: self >> relics + target >> relics
            ships: self >> ships + target >> ships
            margin: self >> margin + .015
        xx
        overlays: transfer
        links: inherit
    xx

    transition absorb
        targets: RebelFederation where (self >> power) > (target >> power) * 1.5 and (target >> population) < 90000
        carries:
            aggression: self >> aggression + ((target >> aggression) * .025)
            cooperation: self >> cooperation - .015
            fear: self >> fear + ((target >> fear) * .06)
            ambition: self >> ambition
            cohesion: self >> cohesion - .035
            stability: self >> stability - .025
            succession: self >> succession - .02
            honor: self >> honor - .015
            spirituality: self >> spirituality
            openness: self >> openness + ((target >> openness) * .015)
            discipline: self >> discipline - .01
            power: self >> power + (target >> power * .12)
            population: self >> population + target >> population
            gold: self >> gold + target >> gold
            food: self >> food + (target >> food * .55)
            iron: self >> iron + (target >> iron * .55)
            mana: self >> mana + (target >> mana * .45)
            wood: self >> wood + (target >> wood * .55)
            horses: self >> horses + (target >> horses * .55)
            stone: self >> stone + (target >> stone * .55)
            relics: self >> relics + target >> relics
            ships: self >> ships + target >> ships
            margin: self >> margin + .012
        xx
        overlays: transfer
        links: inherit
    xx

    transition mutate where (self >> stability) < .16 and (self >> succession) < .18 and (self >> cohesion) > .45 and (self >> discipline) > .45
        into: WarlordState
        carries:
            aggression: self >> aggression + .12
            cooperation: self >> cooperation * .55
            fear: self >> fear
            ambition: self >> ambition
            cohesion: self >> cohesion * .75
            stability: .32
            succession: .2
            honor: self >> honor * .65
            spirituality: self >> spirituality
            openness: self >> openness * .65
            discipline: self >> discipline
            power: self >> power
            population: self >> population
            gold: self >> gold
            food: self >> food
            iron: self >> iron
            mana: self >> mana
            wood: self >> wood
            horses: self >> horses
            stone: self >> stone
            relics: self >> relics
            ships: self >> ships
            margin: self >> margin + .03
        xx
        overlays: transfer
        links: reset
    xx

    transition mutate where (self >> stability) < .22 and (self >> spirituality) > .75 and (self >> cohesion) > .5
        into: Theocracy
        carries:
            aggression: self >> aggression
            cooperation: self >> cooperation
            fear: self >> fear
            ambition: self >> ambition * .75
            cohesion: self >> cohesion
            stability: .45
            succession: .5
            honor: self >> honor
            spirituality: self >> spirituality
            openness: self >> openness * .65
            discipline: self >> discipline
            power: self >> power
            population: self >> population
            gold: self >> gold
            food: self >> food
            iron: self >> iron
            mana: self >> mana
            wood: self >> wood
            horses: self >> horses
            stone: self >> stone
            relics: self >> relics
            ships: self >> ships
            margin: self >> margin
        xx
        overlays: transfer
        links: inherit
    xx

    transition fracture where (self >> stability) < .3 and (self >> cohesion) < .45 and (self >> population) > 250000
        into: WarlordState
        fragment:
            aggression: self >> aggression + .18
            cooperation: self >> cooperation * .45
            fear: self >> fear
            ambition: self >> ambition
            cohesion: .32
            stability: .26
