/// Bang writes on a variable change only that variable, even when the VM
/// makes them in place: other names bound to the same list or map, nested
/// values read out earlier and an action's caller keep their values.
a | [1, 2]
b | a
:put_last!(a, 3)
say(b)
say(a)
m | {"k": [1]}
row | m["k"]
:update!(m["k"][0], 5)
say(row)
say(m)
act grow(xs)
    :put_last!(xs, 9)
    return xs
xx
c | [7]
say(grow(c))
say(c)
d | [1]
say([d, :put_last!(d, 2)])
i | 0
while i < 3
    :put_first!(d, i)
    i |= i + 1
xx
say(d)
