/// keep_between: include_delims keeps the brackets; an unclosed span runs to EOF unless allow_eof_close is false.
say(:keep_between("a[b]c", "[", "]", {"include_delims": true}))
r | :keep_between("a[bc", "[", "]")
say("[{r}]")
r |= :keep_between("a[bc", "[", "]", {"allow_eof_close": false})
say("[{r}]")
