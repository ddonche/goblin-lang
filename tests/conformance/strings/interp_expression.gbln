/// known-gap: interp leaves an expression in braces as written
/// `{expr}` fills in an expression when every name in it is a variable in
/// scope (operators, `>>` fields, indexes and calls). Anything else in
/// braces, such as CSS, an unknown name or a regex `{1,3}`, stays as written.
x | 1
lost | [3, 5]
<>P |
    ~name: "pip"
    ~hp: 7
xx
p <> P | name: "pip"
say("{x + 1}")
say("{lost[0]} and {lost[x]}")
say("{p >> name} has {p >> hp * 2}")
say("{:upper(p >> name)}")
say("css { color: red; }, {nope + 1} and {1,3} stay")
act f(n)
    say("{n * 3}")
xx
f(5)
