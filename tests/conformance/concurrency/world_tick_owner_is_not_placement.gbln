/// known-gap: interp has no concurrency builtins (VM only, spec 2026-10-08)
/// `owner` is a relationship, not a place (Daniel, 2026-11-02). An actor
/// runs the objects in its state. Setting an object's `owner` to an object
/// another actor runs changes who owns it and nothing else: it keeps
/// running where it ran. `:move!(x, y)` moves `x` alone to where `y` runs
/// (an object or a region actor); what `x` owns stays where it runs. An
/// object the main program makes runs nowhere until it is moved.
/// (The main program lists the regions' objects region by region, so the
/// order of the names shows where each one runs.)
<>Meadow |
    n: 0
xx
<>Rabbit |
    name: ..
    owner: nil
    age: 0
    every 1 tick
        @age |= @age + 1
        if @name == "bun" and @age == 2
            @owner |= :objects("Meadow", it >> n == 3)[0]
        xx
        if @name == "r3" and @age == 2
            :move!(self, :objects("Meadow", it >> n == 1)[0])
        xx
    xx
xx
<>Bag |
    name: ..
    owner: nil
xx
act make(i)
    m <> Meadow | n: i
    r <> Rabbit | name: "r{i}", owner: m
    if i == 1
        bun <> Rabbit | name: "bun", owner: m
        b <> Bag | name: "bag", owner: bun
        return [m, r, bun, b]
    xx
    return [m, r]
xx
meadows | []
repeat :range(1, 4) as i
    :put_last!(meadows, :actor(make(i)))
xx
act show(t)
    names | []
    repeat :objects() as o
        if :is_type(o, "Rabbit")
            :put_last!(names, "{o >> name}@{o >> owner >> n}:{o >> age}")
        elif :is_type(o, "Bag")
            :put_last!(names, "{o >> name}@{o >> owner >> name}")
        xx
    xx
    say("tick {t}: {names}")
xx
repeat :range(1, 5) as t
    tick(meadows)
    show(t)
    if t == 3
        m2 | :objects("Meadow", it >> n == 2)[0]
        kit <> Rabbit | name: "kit", owner: m2
        idle <> Rabbit | name: "idle", owner: m2
        :move!(kit, m2)
    xx
xx
