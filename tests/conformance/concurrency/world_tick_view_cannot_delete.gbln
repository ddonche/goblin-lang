/// known-gap: interp has no concurrency builtins (VM only, spec 2026-10-08)
/// The main program cannot delete a region's object, or the overlays on
/// it, either (C0124): only the region that owns it can.
<>Person |
    health: .9
xx
act make_one()
    p <> Person | health: .9
    return {"people": [p]}
xx
act day(st, msg)
    return st
xx
r | :actor(make_one(), day)
tick([r])
repeat :objects(it >> health > 0)
    x | it
    attempt
        delete_object!(x)
    rescue e
        say(:has("{e}", "C0124: region-object-read-only"))
    xx
    attempt
        delete_overlays_on!(x)
    rescue e
        say(:has("{e}", "C0124: region-object-read-only"))
    xx
xx
tick([r])
n | :len(:objects(it >> health > 0))
say("still {n}")
