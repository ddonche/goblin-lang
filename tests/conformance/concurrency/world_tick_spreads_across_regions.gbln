/// known-gap: interp has no concurrency builtins (VM only, spec 2026-10-08)
/// tick(regions) ticks every region together. An overlay spreads inside a
/// region during the tick; one that reaches another region's object
/// through a link lands there at the start of the next tick. The main
/// program's :objects() and :overlays() see every region. At chance 1,
/// everyone in town catches it.
:rand_seed(42)
<>Person |
    health: 1
    town: 0
xx
link contact
    hosts: Person
    range: 0...1
    score => 1 - :abs((@town) - (target >> town)) * .5
xx
overlay flu
    hosts: Person
    spread: 1 where :link_score(@, target, contact) > .3
    modify
        @health - .02
    xx
xx
act make_town(t, n, sick)
    people | []
    repeat :range(0, n) as i
        p <> Person | town: t
        if i < sick
            :overlay!(p, flu)
        xx
        :put_last!(people, p)
    xx
    return {"town": t, "people": people}
xx
act town_day(st, msg)
    return st
xx
north | :actor(make_town(0, 3, 1), town_day)
south | :actor(make_town(.5, 2, 0), town_day)
repeat :range(1, 4) as d
    n | tick([north, south])
    ill | :len(:overlays(flu))
    hit_n | 0
    hit_s | 0
    repeat :objects((it >> health) < 1)
        if (it >> town) < .25
            hit_n |= hit_n + 1
        else
            hit_s |= hit_s + 1
        xx
    xx
    all | :len(:objects((it >> health) > 0))
    say("tick {n}: flu {ill}, north {hit_n}, south {hit_s}, people {all}")
xx
