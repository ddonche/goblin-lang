/// known-gap: interp has no concurrency builtins (VM only, spec 2026-10-08)
/// :tick() takes no arguments; a region that fails during the tick makes
/// the tick fail (C0123) instead of waiting forever.
<>Thing |
    n: 0
xx
act bad(st, msg)
    if :has(msg, "tick")
        x | 1 / 0
    xx
    return st
xx
attempt
    :tick([1, 2])
rescue e
    :say(:has("{e}", "tick"))
xx
act make_region()
    t <> Thing | n: 1
    return {"things": [t]}
xx
r | :actor(make_region(), bad)
attempt
    :tick()
rescue e
    :say(:has("{e}", "C0123: tick-regions: a region failed"))
xx
