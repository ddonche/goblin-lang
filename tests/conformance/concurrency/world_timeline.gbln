/// known-gap: interp has no concurrency builtins (VM only, spec 2026-10-08)
/// With regions, `:timeline` sees the lines the regions handed back: a
/// fragment made in a region has its own lines and its parent's before it.
<>Land |
    food: 0
    name: ..
    phase: grow
        every 1 tick
            @food |= @food + 3
        xx
    xx
    phase: take
        decision raid
            targets: Land where target >> food > @food
            score => target >> food
        xx
        judge
            raid: self.raid(raid >> target)
        xx
    xx
    act raid(t)
        t >> food |= t >> food - 2
        @food |= @food + 2
    xx
    transition fracture where @food > 10
        fragment:
            name: "{@name} march"
            food: 1
        xx
        carries:
            food: @food - 5
        xx
    xx
xx
overlay rumor
    hosts: Land
    spread: 1 where (target >> name) == "south"
xx
act make(n, f)
    l <> Land | name: n, food: f
    return {"things": [l]}
xx
d | :env("GOBLIN_CONF_TMP")
:event_log("{d}/world_timeline.log")
north | :actor(make("north", 0))
south | :actor(make("south", 5))
:tick()
    grow
    take
xx
:overlay!(:get_first(:objects(Land, it >> name == "north")), rumor)
repeat 3
    :tick()
        grow
        take
    xx
xx
march | :get_first(:objects(Land, it >> name == "south march"))
repeat :timeline(march) as l
    :say(l)
xx
:say("--")
repeat :timeline("rumor") as l
    :say(l)
xx
