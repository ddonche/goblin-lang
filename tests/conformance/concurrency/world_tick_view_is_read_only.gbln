/// known-gap: interp has no concurrency builtins (VM only, spec 2026-10-08)
/// After tick(regions) the main program sees the regions' objects as of
/// the last tick, and cannot change them (C0124): a change made there
/// would be lost at the next tick. A region changes its own objects.
<>Person |
    health: .9
xx
act make_one()
    p <> Person | health: .9
    return {"people": [p]}
xx
act day(st, msg)
    return st
xx
r | :actor(make_one(), day)
tick([r])
repeat :objects(it >> health > 0)
    h | it >> health
    say("seen {h}")
    attempt
        it >> health |= .2
    rescue e
        say(:has("{e}", "C0124: region-object-read-only"))
    xx
xx
tick([r])
repeat :objects(it >> health > 0)
    h | it >> health
    say("still {h}")
xx
