/// known-gap: interp has no concurrency builtins (VM only, spec 2026-10-08)
/// A region's stop_when is checked after each tick, as after any message:
/// once it holds, the region stops and :await gives its last state. The
/// next :tick() runs the world without it.
<>Thing |
    n: 0
xx
act count(st, msg)
    if :has(msg, "tick")
        :update!(st{"ticks"}, st{"ticks"} + 1)
    xx
    return st
xx
act enough(st)
    return st{"ticks"} >= 2
xx
act make_region()
    t <> Thing | n: 1
    return {"things": [t], "ticks": 0}
xx
r | :actor(make_region(), count, {stop_when: enough})
tick()
tick()
say(:await(r){"ticks"})
say(:len(:objects(Thing)))
tick()
say(:len(:objects(Thing)))
