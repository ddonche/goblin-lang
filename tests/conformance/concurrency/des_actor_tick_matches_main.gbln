/// known-gap: interp has no concurrency builtins (VM only, spec 2026-10-08)
/// The same small world ticked inside an actor ends the same as when the
/// starting program ticks it: overlays, spread through links, decisions and
/// transitions all run there.
:rand_seed(5)
<>Person |
    health: .9
    hunger: .5
    transition erase where @health < .3
xx
overlay sick
    hosts: Person
    spread: .9 where :link_score(@, target, contact) > .3
    decays: .02
    modify
        @health - .08
    xx
xx
link contact
    hosts: Person
    range: 0...1
    score => (@hunger) * .5 + (target >> hunger) * .5
xx
act world(n)
    people | []
    repeat :range(0, n) as i
        p <> Person | health: .9 - i * .05, hunger: .6
        :put_last!(people, p)
    xx
    return {"people": people}
xx
act report(label)
    hs | []
    repeat :objects(it >> health > 0)
        h | it >> health
        :put_last!(hs, :round(h * 1000))
    xx
    ill | :len(:overlays(sick))
    say("{label}: {hs} sick {ill}")
xx
act run(st, msg)
    first | st{"people"}[0]
    :overlay!(first, sick, .9)
    repeat 8
        tick()
    xx
    report("actor")
    return st
xx
here | world(4)
first | here{"people"}[0]
:overlay!(first, sick, .9)
repeat 8
    tick()
xx
report("main")
:delete!(here, "people")
r | :actor(world(4), run)
:post(r, "go")
:halt(r)
