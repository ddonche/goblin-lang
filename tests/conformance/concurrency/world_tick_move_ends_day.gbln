/// known-gap: interp has no concurrency builtins (VM only, spec 2026-10-08)
/// `:move!` sends the object at once: it does nothing more in its old
/// region that tick (no decision there against the new region's objects),
/// and acts in its new region from the next tick.
<>Meadow |
    n: 0
xx
<>Grass |
    owner: nil
    bites: 0
xx
<>Rabbit |
    owner: nil
    every 1 tick
        if @owner >> n == 1
            next | :objects("Meadow", it >> n == 2)[0]
            @owner |= next
            :move!(self, next)
        xx
    end
    decision patch
        targets: Grass where (target >> owner) == @owner
    xx
    judge
        patch and (patch >> score) >= 0: eat(self, patch >> target)
    xx
xx
act eat(r, g)
    g >> bites |= g >> bites + 1
xx
act make(i)
    m <> Meadow | n: i
    g <> Grass | owner: m
    if i == 1
        r <> Rabbit | owner: m
        return [m, g, r]
    xx
    return [m, g]
xx
meadows | []
repeat :range(1, 3) as i
    :put_last!(meadows, :actor(make(i)))
xx
repeat :range(1, 4) as t
    :tick()
    bites | []
    repeat :objects("Grass") as g
        :put_last!(bites, "{g >> owner >> n}:{g >> bites}")
    xx
    :say("tick {t}: {bites}")
xx
