/// known-gap: interp has no concurrency builtins (VM only, spec 2026-10-08)
/// `owner` is a relationship, not a place: an actor runs only the objects
/// in its state, and :move! moves one object. The lord moves east; his bag
/// and coins stay in the west, still his. Moving each of them moves them.
<>Person |
    name: ""
xx
<>Bag |
    owner: nil
xx
<>Coin |
    owner: nil
    worth: 1
xx
act make_region(name, rich)
    folk | []
    if rich
        p <> Person | name: "lord"
        b <> Bag | owner: p
        :put_last!(folk, p)
        :put_last!(folk, b)
        repeat :range(0, 3)
            c <> Coin | owner: b
            :put_last!(folk, c)
        xx
        c <> Coin | owner: p, worth: 10
        :put_last!(folk, c)
    xx
    return {"name": name, "folk": folk, "peer": nil, "seen": nil}
xx
act wealth()
    n | 0
    repeat :objects("Coin") as c
        n |= n + c >> worth
    xx
    return n
xx
act region_day(st, msg)
    if :has(msg, "peer")
        :update!(st{"peer"}, msg{"peer"})
    elif :has(msg, "tick")
        if msg{"tick"} == 1 and st{"name"} == "west"
            :move!(st{"folk"}[0], st{"peer"})
        xx
        if msg{"tick"} == 2 and st{"name"} == "west"
            repeat st{"folk"} as x
                if idx == 0 => skip
                :move!(x, st{"peer"})
            xx
            :update!(st{"folk"}, [])
        xx
    elif :has(msg, "ask")
        :update!(st{"seen"}, {"people": :len(:objects("Person")), "coins": :len(:objects("Coin")), "bags": :len(:objects("Bag")), "wealth": wealth()})
    xx
    return st
xx
west | :actor(make_region("west", true), region_day)
east | :actor(make_region("east", false), region_day)
:post(west, {"peer": east})
:post(east, {"peer": west})
repeat :range(1, 5) as d
    w | :await(:request(west, {"ask": 1})){"seen"}
    e | :await(:request(east, {"ask": 1})){"seen"}
    say("before tick {d}: west {w}, east {e}")
    tick([west, east])
xx
say(:len(:objects("Coin")))
