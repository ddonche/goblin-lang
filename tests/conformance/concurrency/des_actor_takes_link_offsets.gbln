/// known-gap: interp has no concurrency builtins (VM only, spec 2026-10-08)
/// A link offset on objects handed to an actor goes with them, with the
/// ticks it has left: the actor's link scores include it until it runs out.
<>Person |
    hunger: .4
xx
link Person contact by [
    self >> hunger * .5 + target >> hunger * .5
]
act make()
    a <> Person | hunger: .4
    b <> Person | hunger: .4
    a link to b on contact offset +.3 for 2 ticks
    say(:link_score("Person", "contact", "a", "b"))
    return [a, b]
xx
act region(st, msg)
    a | st{"people"}[0]
    b | st{"people"}[1]
    say(:link_score("Person", "contact", "a", "b"))
    tick()
    say(:link_score("Person", "contact", "a", "b"))
    tick()
    say(:link_score("Person", "contact", "a", "b"))
    return st
xx
r | :actor({"people": make()}, region)
:post(r, "go")
:halt(r)
