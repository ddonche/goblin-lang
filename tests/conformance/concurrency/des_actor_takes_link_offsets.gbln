/// known-gap: interp has no concurrency builtins (VM only, spec 2026-10-08)
/// A link change (`:link!` with ticks) on objects handed to an actor goes with them, with the
/// ticks it has left: the actor's link scores include it until it runs out.
<>Person |
    hunger: .4
xx
link contact
    hosts: Person
    range: 0...1
    score => @hunger * .5 + (target >> hunger) * .5
xx
act make()
    a <> Person | hunger: .4
    b <> Person | hunger: .4
    :link!(a, b, contact, .3, 2)
    :say(:link_score(a, b, "contact"))
    return [a, b]
xx
act region(st, msg)
    a | st{"people"}[0]
    b | st{"people"}[1]
    :say(:link_score(a, b, "contact"))
    :tick()
    :say(:link_score(a, b, "contact"))
    :tick()
    :say(:link_score(a, b, "contact"))
    return st
xx
r | :actor({"people": make()}, region)
:post(r, "go")
:halt(r)
