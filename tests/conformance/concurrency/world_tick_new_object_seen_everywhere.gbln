/// known-gap: interp has no concurrency builtins (VM only, spec 2026-10-08)
/// An object the main program makes for a meadow is seen by every region
/// on the tick it arrives, not only by its own. And when the main program
/// puts an object that another region runs into such a new holder, that
/// object moves from its own region: it is not copied (the sack counts
/// one step a tick for it; before, it counted a step twice).
<>Meadow |
    n: 0
    ~seen: 0
    every 1 tick
        self >> seen |= :len(:objects("Rabbit"))
    end
xx
<>Rabbit |
    name: ""
    owner: nil
    ~age: 0
    every 1 tick
        self >> age |= self >> age + 1
        if :is_type(self >> owner, "Bag")
            self >> owner >> steps |= self >> owner >> steps + 1
        xx
    end
xx
<>Bag |
    name: ""
    owner: nil
    ~steps: 0
xx
act make(i)
    m <> Meadow | n: i
    r <> Rabbit | name: "r{i}", owner: m
    return m
xx
meadows | []
repeat :range(1, 3) as i
    :put_last!(meadows, :actor(make(i)))
xx
act show(t)
    names | []
    repeat :objects() as o
        if :is_type(o, "Bag")
            :put_last!(names, "{o >> name} {o >> steps} steps")
        elif :is_type(o, "Meadow")
            :put_last!(names, "m{o >> n} sees {o >> seen}")
        elif :is_type(o, "Rabbit")
            h | o >> owner
            at | ""
            if :is_type(h, "Bag")
                at |= h >> name
            else
                at |= "m{h >> n}"
            xx
            :put_last!(names, "{o >> name}@{at}:{o >> age}")
        xx
    xx
    say("tick {t}: {names}")
xx
repeat :range(1, 7) as t
    tick(meadows)
    show(t)
    if t == 1
        m2 | :objects("Meadow", it >> n == 2)[0]
        kit <> Rabbit | name: "kit", owner: m2
    elif t == 2
        m2 | :objects("Meadow", it >> n == 2)[0]
        r1 | :objects("Rabbit", it >> name == "r1")[0]
        sack <> Bag | name: "sack", owner: m2
        r1 >> owner |= sack
    xx
xx
