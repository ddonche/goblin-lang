/// `import "...{x}..." as a` builds the path when the statement runs; it then
/// imports like the same literal path (runs once, extension added).
side | "left"
import "_support/modules/{side}" as l
:say(l::name())
act load_right(dir)
    import "{dir}/right.gbln" as r
    return r::name()
xx
:say(load_right("_support/modules"))
import "_support/modules/{side}" as again
:say(again::name())
