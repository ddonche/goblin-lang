/// requires: http
/// known-gap: interp http_* builtins exist only on the VM ("unknown action")
/// The body is raw text; json_parse turns a JSON body into values.
base | :env("GOBLIN_CONF_HTTP")
r | :http_get("{base}/json")
say(:is_str(r{"body"}))
j | :json_parse(r{"body"})
say(j{"a"})
say(j{"b"}[0])
say(:is_nil(j{"b"}[1]))
