/// zip_dir! writes a zip archive (starts with the "PK" signature) of a directory.
d | :env("GOBLIN_CONF_TMP")
:create_dir!("{d}/src/sub")
:write_text!("{d}/src/a.txt", "hello")
:write_text!("{d}/src/sub/b.txt", "world")
:zip_dir!("{d}/src", "{d}/out.zip")
say(:is_file("{d}/out.zip"))
r | :json_parse(:run_cmd("head -c 2 out.zip", d))
say(:ends_with(r["stdout"], "PK"))
say(:file_exists("{d}/src/a.txt"))
