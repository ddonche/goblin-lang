/// known-gap: interp has no overlay classes (`<^>`); the interpreter is being retired
/// An overlay is an object: a copy's intensity and fields are written like
/// any object's fields (`o >> intensity |= .9`), and its `modify` lines are
/// worked out again at once. Intensity stays in 0..1; `ticks_remaining`
/// takes a whole number or nil. The fields that say which copy it is, and
/// its age, are the runtime's (R1249); so is a copy no longer on its host.
<>Land |
    piety: 1
xx
<^>Faith |
    hosts: Land
    modify
        @piety + intensity * fervor
    xx
xx
overlay sun <^> Faith
    fervor: 2
xx
act preach(o, by)
    o >> intensity |= (o >> intensity) + by
xx
a <> Land | piety: 1
:overlay!(a, sun, .5)
:say(a >> piety)
repeat :overlays(a, sun) as o
    preach(o, .2)
xx
:say(a >> piety)
repeat :overlays(a, sun) as o
    o >> fervor |= 10
    o >> intensity |= 5
    o >> ticks_remaining |= 2
    :say("{o >> intensity} {o >> fervor} {o >> ticks_remaining}")
xx
:say("{a >> piety} {:field(a, "piety")}")
:tick()
:tick()
:say("{:overlays(a)} {a >> piety}")
