/// known-gap: interp has no decision blocks (decision name ... xx); the interpreter is being retired
/// A judge arm calls actions as any code does: the class's own action
/// `self.purchase(shop >> target, 3)` runs with the shop and 3,
/// `self.rest()` with nothing more, and the program action `tip(self, ...)` gets what
/// the arm passes, here a value worked out from the pick's score.
<>Shop |
    stock: 0
    sold: 0
    tips: 0
xx
<>Buyer |
    spent: 0
    rests: 0
    want: 1
    decision shop
        targets: Shop
        score => target >> stock
    xx
    judge
        shop and (shop >> score) >= .5: self.purchase(shop >> target, 3)
        shop: self.rest()
    xx
    act purchase(target, n)
        target >> sold |= target >> sold + n
        self >> spent |= self >> spent + 5 * n
    end
    act rest()
        self >> rests |= self >> rests + 1
    end
xx
<>Tipper |
    kind: 1
    decision shop
        targets: Shop
        score => target >> stock
    xx
    judge
        shop: tip(self, shop >> target, (shop >> score) > .5)
    xx
xx
act tip(t, s, generous)
    if generous
        s >> tips |= s >> tips + 2
    xx
xx
a <> Shop | stock: 10
b <> Buyer | spent: 0
t <> Tipper | kind: 1
:tick()
:tick()
:say(a >> sold)
:say(b >> spent)
:say(a >> tips)
a >> stock |= 0
:tick()
:say(b >> rests)
