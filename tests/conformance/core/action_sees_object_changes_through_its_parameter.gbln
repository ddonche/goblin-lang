/// known-gap: interp has no block overlay syntax (overlay name ... xx); the interpreter is being retired
/// An object passed to an action is the object itself: changes made to it
/// elsewhere, such as by an overlay, show through the parameter.
<>Polity |
    fear: .3
xx
overlay dread
    modify
        @fear + .04
    xx
xx
act frighten(target)
    :overlay!(target, dread, .5)
    target >> fear |= target >> fear + .1
    :say(target >> fear)
end
act read(target)
    rome >> fear |= .9
    :say(target >> fear)
end
rome <> Polity | fear: .3
frighten(rome)
:say(rome >> fear)
read(rome)
