/// known-gap: interp has no decision blocks (decision name ... xx); the interpreter is being retired
/// `targets: Class where condition` leaves targets out of a decision before
/// scoring: only those for which it is true are scored. With none left, the
/// pick is nil. `margin:` can go on any line of the block.
<>F |
    name: ""
    side: 0
    hp: 10
    max_hp: 10
    decision foe
        targets: F where (target >> side) != @side and (target >> hp) > 0
        score => 1 - (target >> hp) / (target >> max_hp)
    xx
    decision hurt
        targets: F where (target >> side) == @side and (target >> hp) * 2 < (target >> max_hp)
        score => 1 - (target >> hp) / (target >> max_hp)
        margin: 0
    xx
    judge_all
        foe and (foe >> score) >= 0: hit(self, foe >> target)
        hurt and (hurt >> score) >= 0: mend(self, hurt >> target)
    xx
xx
act hit(f, t)
    a | f >> name
    b | t >> name
    :say("{a} hits {b}")
xx
act mend(f, t)
    a | f >> name
    b | t >> name
    :say("{a} heals {b}")
xx
x <> F | name: "x", side: 0, hp: 4
y <> F | name: "y", side: 0, hp: 10
z <> F | name: "z", side: 1, hp: 0
w <> F | name: "w", side: 1, hp: 6
:tick()
