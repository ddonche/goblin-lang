/// known-gap: interp has no block overlay syntax (overlay name ... xx); the interpreter is being retired
/// known-gap: vm whole-number + wraps past the largest whole number everywhere, not only here
/// An overlay's `every` block that takes a whole-number field past the
/// largest whole number stops the tick with an error, not a wrapped or
/// crashed value.
<>C |
    n: 0
xx
overlay up
    lasts: 3
    every 1 tick => @n |= @n + 1
xx
c <> C | n: :int("9223372036854775807")
:overlay!(c, up)
attempt
    :tick()
rescue e
    :say("stopped")
xx
:say(c >> n)
