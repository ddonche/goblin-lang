/// known-gap: interp has no decision blocks (decision name ... xx); the interpreter is being retired
/// Objects made by a matrix keep their class's named decisions.
<>Shop |
    cheap: .8
    hiring: .9
xx
<>Person |
    bought: 0
    jobs: 0
    decision bargain
        targets: Shop
        score => target >> cheap
    xx
    decision job
        targets: Shop
        score => target >> hiring
    xx
    judge_all
        bargain and (bargain >> score) >= .5: buy(self, bargain >> target)
        job and (job >> score) >= .5: apply(self, job >> target)
    xx
xx
act buy(p, s)
    p >> bought |= p >> bought + 1
xx
act apply(p, s)
    p >> jobs |= p >> jobs + 1
xx

<>Person matrix
    name:   "{name}", ann
    bought: 0,        nc
end

s <> Shop | cheap: .8
:tick()
b | ann >> bought
j | ann >> jobs
:say("bought {b}, jobs {j}")
