/// known-gap: interp has no block overlay syntax (overlay name ... xx); the interpreter is being retired
/// `spread: chance where condition`: each tick, each object the condition
/// holds for catches the overlay with that chance, nothing scaled. At .1
/// about a tenth of the town catches it on the first day; at 1 all of it;
/// at 0 none.
<>P |
    town: 0
xx
overlay cold
    hosts: P
    spread: .1 where (target >> town) == @town
xx
overlay flu
    hosts: P
    spread: 1 where (target >> town) == @town
xx
overlay pox
    hosts: P
    spread: 0 where (target >> town) == @town
xx
act day_one(name)
    :rand_seed(3)
    repeat :objects() as o
        :delete_object!(o)
    xx
    first | nil
    repeat :range(0, 200) as i
        p <> P | town: i % 2
        if i == 0
            first |= p
        xx
    xx
    :overlay!(first, name)
    :tick()
    return :len(:overlays(name)) - 1
xx
colds | day_one("cold")
:say(colds > 0 and colds < 25)
:say(day_one("flu"))
:say(day_one("pox"))
