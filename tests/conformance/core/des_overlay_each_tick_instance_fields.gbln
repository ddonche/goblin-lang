/// known-gap: interp has no block overlay syntax (overlay name ... xx); the interpreter is being retired
/// An overlay's blocks use the fields of the overlay as it was put on: an
/// overlay defined again later does not change one already on a host.
/// Lines come in any order (`every` before `modify`), and a field named
/// `every` can be changed.
<>F |
    hp: 20
    def: 0
    every: 0
xx
overlay bleed
    rate: 2
    lasts: 5
    every 1 tick
        @hp |= @hp - rate
        @every |= @every + 1
    xx
    modify
        @def + 1
    xx
xx
a <> F | hp: 20
:overlay!(a, bleed)
overlay bleed
    rate: 5
    lasts: 5
    every 1 tick
        @hp |= @hp - rate
        @every |= @every + 1
    xx
    modify
        @def + 1
    xx
xx
tick()
say(a >> hp)
say(a >> def)
say(a >> every)
