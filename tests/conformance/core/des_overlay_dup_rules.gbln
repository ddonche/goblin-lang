/// known-gap: interp has no block overlay syntax (overlay name ... xx); the interpreter is being retired
/// `dup:` decides what putting an overlay on a host that has it does:
/// `ignore` (the default) keeps the copy there, `replace` takes it off
/// and puts the new one on, `stack` adds a copy with its own clock.
/// Each copy's `modify` lines count.
<>K |
    def: 10
xx
overlay ward
    modify
        @def + 1
    xx
xx
overlay curse
    dup: replace
    lasts: 3
    modify
        @def - 2
    xx
xx
overlay chill
    dup: stack
    lasts: 2
    modify
        @def - 1
    xx
xx
k <> K | def: 10
:overlay!(k, ward, .5)
:overlay!(k, ward, .9)
n | :len(:overlays(k, ward))
:say("ward: {n} copy, def {k >> def}")
:detach!(k, ward)
:overlay!(k, curse)
:tick()
:overlay!(k, curse)
:tick()
:tick()
c | :overlays(k, curse)[0]
n |= :len(:overlays(k, curse))
:say("curse: {n} copy, {c >> ticks_remaining} ticks left, def {k >> def}")
:detach!(k, curse)
:overlay!(k, chill)
:tick()
:overlay!(k, chill)
n |= :len(:overlays(k, chill))
:say("chill: {n} copies, def {k >> def}")
:tick()
n |= :len(:overlays(k, chill))
:say("chill: {n} copy, def {k >> def}")
:tick()
:say("def {k >> def}")
