/// known-gap: interp requires `by [ ... ]`
/// A decision can leave out `by [ ... ]`: every target that passes its
/// `where` scores the same, 1, and the judge sees that score.
<>Village |
    ~n: 0
    ~food: 0
xx
<>P |
    ~village: 0
    eat | decision against Village where [ target >> n == self >> village ]
    judge using eat
        >= 1: take(target)
    end
xx
act take(p, v)
    v >> food |= v >> food - 1
xx
v0 <> Village | n: 0, food: 10
v1 <> Village | n: 1, food: 10
a <> P | village: 0
b <> P | village: 0
c <> P | village: 1
tick()
say(v0 >> food)
say(v1 >> food)
Germany <> P | village: 1
Germany score | decision against Village where [ target >> n == 0 ]
tick()
say(v0 >> food)
say(v1 >> food)
