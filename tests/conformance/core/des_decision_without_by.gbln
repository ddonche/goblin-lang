/// known-gap: interp has no decision blocks (decision name ... xx); the interpreter is being retired
/// A decision can leave out `score`: every target that passes its `where`
/// scores the same, 1, and the judge sees that score.
<>Village |
    n: 0
    food: 0
xx
<>P |
    village: 0
    decision home
        targets: Village where (target >> n) == @village
    xx
    judge
        home and (home >> score) >= 1: take(self, home >> target)
    xx
xx
act take(p, v)
    v >> food |= v >> food - 1
xx
v0 <> Village | n: 0, food: 10
v1 <> Village | n: 1, food: 10
a <> P | village: 0
b <> P | village: 0
c <> P | village: 1
tick()
say(v0 >> food)
say(v1 >> food)
