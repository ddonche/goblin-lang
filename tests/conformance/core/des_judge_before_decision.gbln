/// known-gap: interp has no decision blocks (decision name ... xx); the interpreter is being retired
/// A class's judge can come before the decisions it reads: it finds them
/// by name.
<>Shop |
    cheap: .8
xx
<>Person |
    bought: 0
    judge
        bargain and (bargain >> score) >= .5: buy(self, bargain >> target)
    xx
    decision bargain
        targets: Shop
        score => target >> cheap
    xx
xx
act buy(p, s)
    p >> bought |= p >> bought + 1
xx
s <> Shop | cheap: .8
p <> Person | bought: 0
tick()
tick()
b | p >> bought
say("bought {b}")
