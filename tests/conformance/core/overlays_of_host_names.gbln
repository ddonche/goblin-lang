/// known-gap: interp has no block overlay syntax (overlay name ... xx); the interpreter is being retired
/// overlays_of(host_name) lists the names of the overlays on that host ([] for none or an unknown host).
<>Polity |
    stability: .8
xx
overlay stunned
    modify
        @stability - .25
    xx
xx
overlay plague
    modify
        @stability - .5
    xx
xx
rome <> Polity | stability: .8
athens <> Polity | stability: .8
:overlay!(rome, stunned, .5)
:overlay!(rome, plague, .2)
:say(:sort(:overlays_of("rome")))
:say(:overlays_of("athens"))
:say(:overlays_of("nobody"))
