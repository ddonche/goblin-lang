/// known-gap: interp has no decision blocks (decision name ... xx); the interpreter is being retired
/// A class can have several decisions, each named; its judge reads each
/// pick by the decision's name, every tick.
:rand_seed(5)
<>Shop |
    open: 1
    hiring: .9
    cheap: .8
xx
<>Person |
    bought: 0
    jobs: 0
    decision bargain
        targets: Shop
        score => target >> cheap
    xx
    decision job
        targets: Shop
        score => target >> hiring
    xx
    judge_all
        bargain and (bargain >> score) >= .5: buy(self, bargain >> target)
        job and (job >> score) >= .95: apply(self, job >> target)
        job: wait(self, job >> target)
    xx
xx
act buy(p, s)
    p >> bought |= p >> bought + 1
xx
act apply(p, s)
    p >> jobs |= p >> jobs + 1
xx
act wait(p, s)
    say("waiting")
xx
s <> Shop | open: 1
p <> Person | bought: 0
tick()
tick()
b | p >> bought
j | p >> jobs
say("bought {b}, jobs {j}")
