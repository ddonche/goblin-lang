/// known-gap: interp has no block overlay syntax (overlay name ... xx); the interpreter is being retired
/// An overlay declared with "lasts N ticks" expires after N ticks when applied without "for".
<>Polity |
    stability: .8
xx
overlay stunned
    lasts: 2
    modify
        @stability - .25
    xx
xx
rome <> Polity | stability: .8
:overlay!(rome, stunned, .5)
:say(rome >> stability)
:tick()
:say(:overlays_of("rome"))
:tick()
:say(rome >> stability)
:say(:overlays_of("rome"))
