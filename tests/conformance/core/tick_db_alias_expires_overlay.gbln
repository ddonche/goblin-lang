/// known-gap: interp has no block overlay syntax (overlay name ... xx); the interpreter is being retired
/// tick_db() is an alias of tick().
<>Polity |
    stability: .8
xx
overlay stunned
    modify
        @stability - .25
    xx
xx
rome <> Polity | stability: .8
:overlay!(rome, stunned, .5, 1)
say(rome >> stability)
tick_db()
say(rome >> stability)
say(:overlays_of("rome"))
