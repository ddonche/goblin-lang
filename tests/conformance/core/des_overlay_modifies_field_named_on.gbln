/// known-gap: interp has no block overlay syntax (overlay name ... xx); the interpreter is being retired
/// A field named `on` can be adjusted in `modify`; only `on end` at the
/// start of an overlay line starts that block.
<>Lamp |
    on: 2
    ended: 0
xx
overlay bright
    lasts: 2
    on end => dim(self)
    modify
        @on + 1
    xx
xx
act dim(l)
    l >> ended |= 1
xx
l <> Lamp | on: 2
:overlay!(l, bright)
say(l >> on)
tick()
tick()
tick()
say(l >> on)
say(l >> ended)
