/// known-gap: interp has no decision blocks (decision name ... xx); the interpreter is being retired
/// An error inside a decision's action stops the tick, as one in an `every`
/// block does, so a mistake there is not mistaken for "nothing happened".
<>Shop |
    stock: 0
xx
<>Buyer |
    margin: 0
    decision shop
        targets: Shop
        score => target >> stock
    xx
    judge
        shop and (shop >> score) > 0: purchase(self, shop >> target)
    xx
xx
act purchase(b, s)
    s >> stok |= s >> stock + 1
xx
a <> Shop | stock: 10
x <> Buyer | margin: 0
attempt
    tick()
    say("no error")
rescue e
    say(:has("{e}", "no field 'stok'"))
xx
