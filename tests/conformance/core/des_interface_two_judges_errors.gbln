/// A class that uses an interface with a judge, where it already has a
/// judge of its own, is an error (P1346): a phase has one judge.
decision partner as diplomacy
    targets: Kingdom
    score => 1
xx
judge as diplomacy
    partner: say("deal")
xx
<>Kingdom |
    uses diplomacy
    decision rival
        targets: Kingdom
        score => 1
    xx
    judge
        rival: say("feud")
    xx
xx
say("never printed")
