/// known-gap: interp has no block overlay syntax (overlay name ... xx); the interpreter is being retired
/// An overlay put on inside an action through a parameter is on the object
/// the parameter holds, and lasts as long as it says.
<>Polity |
    stability: .8
xx
overlay stunned
    modify
        @stability - .25
    xx
xx
act stun(target)
    :overlay!(target, stunned, .5, 2)
end
rome <> Polity | stability: .8
stun(rome)
say(:overlays_of("rome"))
tick()
say(:overlays_of("rome"))
say(rome >> stability)
tick()
say(:overlays_of("rome"))
say(rome >> stability)
