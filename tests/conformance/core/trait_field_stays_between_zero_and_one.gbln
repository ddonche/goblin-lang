/// known-gap: interp reads `~` the old way (a real value) and guesses traits from starting values
/// A `~` field is a trait and stays in 0..1, whatever it is made with or
/// written; every other number field is not clamped.
<>Polity |
    ~stability: .5
    army: 2
    treasury: .5
xx
rome <> Polity | stability: .5
big <> Polity | stability: 1.4
rome >> stability |= 1.7
rome >> army |= 5
rome >> treasury |= 1.7
say(rome >> stability)
say(rome >> army)
say(rome >> treasury)
rome >> stability |= -2
say(rome >> stability)
say(big >> stability)
big >> stability |= 3
say(big >> stability)
