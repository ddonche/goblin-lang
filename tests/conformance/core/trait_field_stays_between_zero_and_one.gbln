/// A field that holds a 0..1 number when the object is made is a trait and
/// stays in 0..1 when written; other numbers and `~` fields are not clamped.
<>Polity |
    stability: .5
    army: 2
    ~treasury: .5
xx
rome <> Polity | stability: .5
big <> Polity | stability: 1.4
rome >> stability |= 1.7
rome >> army |= 5
rome >> treasury |= 1.7
say(rome >> stability)
say(rome >> army)
say(rome >> treasury)
rome >> stability |= -2
say(rome >> stability)
big >> stability |= 3
say(big >> stability)
