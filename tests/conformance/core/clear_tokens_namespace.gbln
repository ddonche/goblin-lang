/// clear_tokens(ns) removes a whole namespace and leaves the others.
:register_token("THEME", "ACCENT", "purple")
:register_token("THEME", "BG", "black")
:register_token("SITE", "TITLE", "Journal")
:clear_tokens("THEME")
say(:len(:list_tokens("THEME")))
say(:len(:list_tokens()))
say(:resolve_token("SITE", "TITLE"))
:clear_tokens("NOPE")
say("ok")
