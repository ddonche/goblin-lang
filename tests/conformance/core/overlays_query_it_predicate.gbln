/// known-gap: interp has no block overlay syntax (overlay name ... xx); the interpreter is being retired
/// :overlays() lists every overlay instance as an object with overlay_name, host_var, intensity,
/// age and ticks_remaining; :overlays(pred) filters with `it` bound to each instance.
<>Polity |
    stability: .8
xx
overlay stunned
    modify
        @stability - .25
    xx
xx
overlay plague
    modify
        @stability - .5
    xx
xx
rome <> Polity | stability: .8
athens <> Polity | stability: .8
:overlay!(rome, stunned, .5, 3)
:overlay!(athens, plague, .2)
:say(:len(:overlays()))
strong | :overlays(it >> intensity > .3)
:say(:len(strong))
:say(strong[0] >> overlay_name)
:say(strong[0] >> host_var)
:say(strong[0] >> intensity)
:say(strong[0] >> ticks_remaining)
:say(strong[0] >> age)
:say(:overlays(it >> host_var == "athens")[0] >> ticks_remaining)
:say(:len(:overlays(it >> intensity > 5)))
