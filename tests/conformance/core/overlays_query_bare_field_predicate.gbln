/// known-gap: interp has no block overlay syntax (overlay name ... xx); the interpreter is being retired
/// Inside an :overlays(...) predicate the instance's fields are in scope by name.
<>Polity |
    stability: .8
xx
overlay stunned
    modify
        @stability - .25
    xx
xx
rome <> Polity | stability: .8
:overlay!(rome, stunned, .5)
say(:len(:overlays(intensity > .3)))
say(:len(:overlays(overlay_name == "plague")))
