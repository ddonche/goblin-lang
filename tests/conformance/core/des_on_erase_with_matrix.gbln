/// known-gap: interp has no `on erase =>` or `transition ... where` (new DES syntax); the interpreter is being retired
/// Objects made by a matrix keep their class's `on erase` code.
<>Person |
    age: 0
    on erase => bury(self)
    every 1 tick
        self >> age |= self >> age + 1
    end
    transition erase where @age > 11
xx
act bury(p)
    a | p >> age
    :say("buried at {a}")
xx

<>Person matrix
    name: "{name}", ann, bob
    age:  10,       nc,  20
end

:tick()
:tick()
:say("done")
