/// known-gap: interp has no block overlay syntax (overlay name ... xx); the interpreter is being retired
/// overlay_strength(overlay_name, host_name) gives the intensity the overlay was put on at, or nil.
<>Polity |
    stability: .8
xx
overlay stunned
    modify
        @stability - .25
    xx
xx
overlay plague
xx
rome <> Polity | stability: .8
athens <> Polity | stability: .8
:overlay!(rome, stunned, .5)
say(:overlay_strength("stunned", "rome"))
say(:overlay_strength("stunned", "athens"))
say(:overlay_strength("plague", "rome"))
