/// known-gap: interp has no link blocks or :link! (new DES syntax); the interpreter is being retired
/// `:link!(a, b, link, change[, ticks])`: the change is any number
/// expression; with ticks, it lasts that long.
<>P |
    n: 0
xx
link trust
    hosts: P
    range: -100...100
    score => 0
xx
a <> P | n: 1
b <> P | n: 2
amount | 4
:link!(a, b, trust, 2 * amount)
:say(:link_score(a, b, "trust"))
:link!(a, b, trust, -amount + 1)
:say(:link_score(a, b, "trust"))
:link!(a, b, trust, .5)
:say(:link_score(a, b, "trust"))
:link!(a, b, trust, -10, 3)
:say(:link_score(a, b, "trust"))
