/// known-gap: interp has no `obj >> {name}` (owner, 2026-11-09); the interpreter is being retired
/// `obj >> {name}` reads the field whose name `name` gives, through the
/// object's overlays, as `obj >> piety` does; `obj >> {name} |= v` writes
/// it. The name is any expression giving text.
<>Land |
    piety: 1
    gold: 3
xx
overlay blessed
    hosts: Land
    modify
        @piety + 1
    xx
xx
a <> Land | piety: 1, gold: 3
:overlay!(a, blessed)
t | "piety"
say("{a >> {t}} {:field(a, t)}")
repeat ["piety", "gold"] as f
    say("{f}: {a >> {f}}")
xx
a >> {"gold"} |= 10
say(a >> gold)
act bump(x, f)
    x >> {f} |= (x >> {f}) + 1
xx
bump(a, "gold")
say(a >> {"go" + "ld"})
