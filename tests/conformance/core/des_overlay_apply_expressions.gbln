/// known-gap: interp has no block overlay syntax (overlay name ... xx); the interpreter is being retired
/// `:overlay!(host, overlay, intensity, ticks)` takes expressions for the
/// intensity and the number of ticks, worked out when the call runs.
<>F |
    hp: 10
    power: 6
xx
overlay stunned
xx
a <> F | hp: 10, power: 6
rounds | 2
:overlay!(a, stunned, a >> power / 10, rounds + 1)
s | :overlay_strength("stunned", a)
:say("strength {s}")
repeat :range(1, 5) as d
    :tick()
    left | :overlays_of(a)
    :say("tick {d}: {left}")
xx
act stun(f, n)
    :overlay!(f, stunned, .5, n)
xx
stun(a, 1)
:tick()
:say(:overlays_of(a))
