/// grid_info returns a map describing the grid.
e | :grid("e", 4, 3, 8)
i | :grid_info("e")
say(i{"name"})
say(i{"width"})
say(i{"height"})
say(i{"mode"})
say(:valtype(i{"mode"}))
say(i{"layers"})
say(i{"has_snapshot"})
say(i{"has_hierarchy"})
:grid_set("e", 0, 0, "zeta", 1)
say(:len(:grid_info(e){"layers"}))
say(:grid_info(:grid("f", 2, 2, "wrapped")){"mode"})
