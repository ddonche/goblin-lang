/// known-gap: interp has no block overlay syntax (overlay name ... xx); the interpreter is being retired
/// `spread: ... where`: only objects the overlay may go on (`hosts:`)
/// catch it, and a condition on a field (`(target >> town) == @town`)
/// reaches exactly the objects whose field matches: numbers by value (1
/// and 1.0), strings by text.
<>P |
    town: 0
    name: ""
xx
<>Rock |
    town: 0
xx
<>Q |
    name: ""
xx
<>S |
    town: 0
xx
/// `target >> is_nil` is the builtin, not a field: every S catches it.
overlay odd
    hosts: S
    spread: 1 where (target >> is_nil) == false
xx
overlay flu
    hosts: P
    spread: 1 where (target >> town) == @town
xx
overlay rumor
    hosts: P, Q
    spread: 1 where (target >> name) == @name
xx
first <> P | town: 1, name: "ann"
same <> P | town: 1.0, name: "bob"
other <> P | town: 2, name: "ann"
r <> Rock | town: 1
q <> Q | name: "ann"
s1 <> S | town: 1
s2 <> S | town: 2
:overlay!(s1, odd)
:overlay!(first, flu)
:overlay!(first, rumor)
:tick()
:say([:len(:overlays(same)), :len(:overlays(other)), :len(:overlays(r)), :len(:overlays(q))])
:say(:len(:overlays(rumor)))
:say(:len(:overlays(s2)))
