/// known-gap: interp runs the old transitions (the interpreter is retired; the VM defines them)
/// split: the object is removed and two new ones take its place, each a
/// copy of it (current fields, ~ traits in 0..1), then first: / second:.
/// What it owned goes to the first; its overlays are copied to both. In
/// on split the old object is still readable and no longer in the world.
<>Land |
    name: ..
    owner: nil
xx
<>Kingdom |
    name: ..
    gold: 0
    ~unity: .5
    owner: nil
    transition split where @gold > 100
        first:
            gold: @gold / 2
        xx
        second:
            gold: @gold / 2
            name: "East {@name}"
        xx
    xx
    on split => report(self, first, second)
xx
overlay plague
    hosts: Kingdom
    ~intensity: .5
xx
act holder(x)
    o | x >> owner
    if o.nix? => send "none"
    return o >> name
xx
act report(old, a, b)
    say("split: {old >> name} ({old >> gold}) -> {a >> name} ({a >> gold}), {b >> name} ({b >> gold})")
    say("old still listed: {:len(:objects(\"Kingdom\", it >> gold == 200))}")
    say("lands of the first: {:len(:objects(\"Land\", it >> owner == a))}")
xx
world <> Kingdom | name: "World"
k <> Kingdom | name: "Varn", gold: 200, owner: world
:overlay!(k, plague)
a <> Land | name: "a", owner: k
b <> Land | name: "b", owner: k
tick()
repeat :objects("Kingdom") as x
    say("{x >> name} gold {x >> gold} unity {x >> unity} owner {holder(x)} overlays {:len(:overlays_of(x))}")
xx
repeat :objects("Land") as l
    say("{l >> name} owner {l >> owner >> name}")
xx
