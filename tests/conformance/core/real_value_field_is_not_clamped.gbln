/// known-gap: interp guesses traits from starting values (0 and 1 count)
/// A number field is a plain value unless marked `~`: one that starts at 0
/// or 1 counts past 1, a `~` one stays in 0..1.
<>Tally |
    ~n: 0
    total: 0
xx
t <> Tally | n: 0
t >> n |= t >> n + 1
t >> n |= t >> n + 1
t >> total |= t >> total + 1
t >> total |= t >> total + 1
t >> total |= t >> total + 1
say(t >> n)
say(t >> total)
