/// known-gap: interp runs the old transitions (the interpreter is retired; the VM defines them)
/// An overlay transition with no into: makes a new kind while the program
/// runs, named after its overlay class (language_1) or its own family
/// (plague_1): a copy of the parent with every line. Each mutating copy
/// becomes its own daughter. An overlay's split must say each intensity.
<>Land |
    name: ..
xx
<^>Language |
    hosts: Land
    transition mutate where age >= 2
    on mutate => say("in {@name} a new language")
xx
overlay old_imperial <^> Language
    ~intensity: .8
    speakers: "many"
xx
overlay plague
    hosts: Land
    ~intensity: .6
    transition split where intensity > .5
        first:
            intensity: intensity * .5
        xx
        second:
            intensity: intensity * .5
            strain: "b"
        xx
    xx
    on split => say("plague splits into {first >> overlay_name} {first >> intensity} and {second >> overlay_name} {second >> intensity}")
xx
a <> Land | name: "Varn"
b <> Land | name: "Oss"
:overlay!(a, old_imperial)
:overlay!(b, old_imperial)
:overlay!(b, plague)
repeat 3
    tick()
xx
repeat :objects("Land") as l
    repeat :overlays_of(l) as o
        say("{l >> name}: {o}")
    xx
xx
repeat :overlays() as o
    say("{o >> overlay_name} on {o >> host_var} intensity {o >> intensity} age {o >> age}")
xx
