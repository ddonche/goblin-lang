/// known-gap: interp has no decision blocks (decision name ... xx); the interpreter is being retired
/// `order: expr` sets the order a class's objects make their decisions
/// in: lowest first; `-` in front of a number turns it round. Equal keys keep the
/// order the objects were made in. It orders only that class's decisions:
/// the other classes keep their places in the pass.
<>F |
    name: ""
    speed: 0
    decision spot
        targets: T
        score => 1
    xx
    judge
        spot: go(self, spot >> target)
    xx
    order: -@speed
xx
<>S |
    name: ""
    rank: ""
    decision spot
        targets: T
        score => 1
    xx
    judge
        spot: go(self, spot >> target)
    xx
    order: @rank
xx
<>T |
    n: 0
xx
act go(f, t)
    a | f >> name
    :say("{a}")
xx
t <> T | n: 1
a <> F | name: "slow", speed: 1
b <> S | name: "s-b", rank: "b"
c <> F | name: "fast", speed: 9
d <> F | name: "tie-1", speed: 5
e <> S | name: "s-a", rank: "a"
f <> F | name: "tie-2", speed: 5
:tick()
