/// `@name` works wherever `self >> name` does: `|=`, chained `>>`,
/// method calls, indexing, after `**`, `//` and `%`, and as `say`'s
/// argument without parentheses.
<>Home |
    ~food: 3
xx
<>P |
    name: "ann"
    ~hp: 120
    tags: ["a", "b"]
    home: nil
    ~n: 2
    act go()
        @hp |= @hp - 1
        @home >> food |= @home >> food + 1
        say(@name.upper())
        say(@hp.min(100))
        say(@tags[1])
        say(@home >> food)
        say(@hp)
        say(2 ** @n)
        say(@hp // @n)
        say(@hp % @n)
        say @n
    xx
xx
h <> Home | food: 3
p <> P | home: h
p.go()
say(p >> hp)
