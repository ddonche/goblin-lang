/// known-gap: interp has no block overlay syntax (overlay name ... xx); the interpreter is being retired
/// delete_overlays_on!(host) removes every overlay instance on that host and leaves others alone.
<>Polity |
    stability: .8
xx
overlay stunned
    modify
        @stability - .25
    xx
xx
rome <> Polity | stability: .8
athens <> Polity | stability: .8
:overlay!(rome, stunned, .5)
:overlay!(athens, stunned, .5)
:say(:len(:overlays()))
:delete_overlays_on!(rome)
:say(:overlays_of("rome"))
:say(:overlays_of("athens"))
:say(:len(:overlays()))
:say(rome >> stability)
:say(athens >> stability)
