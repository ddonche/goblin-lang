/// known-gap: interp has no decision blocks or `transition ... where` (new DES syntax); the interpreter is being retired
/// An object's erase transitions are checked as soon as an action that
/// changed it finishes, never in the middle of one. One killed early in a
/// tick is gone: it doesn't act later that tick and isn't chosen again.
/// Its `on erase` code still runs first.
<>F |
    name: ""
    side: 0
    hp: 3
    decision foe
        targets: F where (target >> side) != @side
        score => 1 - (target >> hp) / 10
    xx
    judge
        foe and (foe >> score) >= 0: strike(self, foe >> target)
    xx
    on erase => fall(self)
    transition erase where @hp <= 0
xx
act strike(f, t)
    a | f >> name
    b | t >> name
    t >> hp |= t >> hp - 5
    h | t >> hp
    :say("{a} hits {b}, hp {h}")
xx
act fall(f)
    a | f >> name
    :say("{a} falls")
xx
x <> F | name: "x", side: 0, hp: 9
y <> F | name: "y", side: 1, hp: 3
z <> F | name: "z", side: 1, hp: 8
:tick()
