/// known-gap: interp has no block overlay syntax (overlay name ... xx); the interpreter is being retired
/// `on end` runs when the overlay runs out: its time is up (pregnant, 3
/// ticks) or its intensity reaches 0 (fever decays away in two ticks).
/// Taking an overlay off by hand (`:detach!`) runs nothing. The block runs
/// with the host as `@`.
<>Person |
    kids: 0
    fevers: 0
    act recover()
        self >> fevers |= self >> fevers + 1
    end
xx
overlay pregnant
    lasts: 3
    on end => give_birth(self)
xx
overlay fever
    decays: .5
    on end => @recover()
xx
act give_birth(mom)
    mom >> kids |= mom >> kids + 1
    :say("a baby")
xx
ann <> Person | kids: 0
bea <> Person | kids: 0
:overlay!(ann, pregnant)
:overlay!(bea, pregnant)
:overlay!(bea, fever)
repeat :range(1, 5) as d
    if d == 2
        :detach!(bea, pregnant)
    xx
    :tick()
    k | ann >> kids
    b | bea >> kids
    f | bea >> fevers
    :say("tick {d}: ann {k} kids, bea {b} kids, bea had {f} fevers")
xx
