/// known-gap: interp has no block overlay syntax (overlay name ... xx); the interpreter is being retired
/// An object made in an action and returned is named by the top-level
/// variable that keeps it, not the action's local.
<>Polity |
    stability: .8
xx
overlay stunned
    modify
        @stability - .25
    xx
xx
act make()
    p <> Polity | stability: .8
    return p
end
act stun(target)
    :overlay!(target, stunned, .5)
end
rome | make()
stun(rome)
say(:overlays_of("rome"))
say(:overlays_of("p"))
say(:overlays()[0] >> host_var)
