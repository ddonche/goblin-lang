/// known-gap: interp has no decision blocks (decision name ... xx); the interpreter is being retired
/// The score a judge sees is the number the formula gives, whatever its
/// fields: a formula of 0..1 traits times 40 scores up to 40, and a
/// constant formula scores that constant (it was squeezed to .5).
<>Spot |
    shade: 0
    picked: 0
xx
<>Walker |
    steps: 0
    decision seat
        targets: Spot
        score => (target >> shade) * 40
    xx
    judge
        seat and (seat >> score) > 30: sit(self, seat >> target, seat >> score)
        seat: pass(self, seat >> target, seat >> score)
    xx
xx
<>Child |
    steps: 0
    decision game
        targets: Spot
        score => 7
    xx
    judge
        game and (game >> score) == 7: sit(self, game >> target, game >> score)
    xx
xx
act sit(w, s, score)
    s >> picked |= s >> picked + 1
    say("sat, score {score}")
xx
act pass(w, s, score)
    say("passed, score {score}")
xx
a <> Spot | shade: .9
w <> Walker | steps: 0
tick()
k <> Child | steps: 0
delete_object!(w)
tick()
