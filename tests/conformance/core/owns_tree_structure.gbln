/// known-gap: interp reads owns_tree from a hard-coded owner_id field and prints ids
/// owns_tree(x) is one line per object inside x at every depth, "Class name" (its name field, else the variable that names it), indented two spaces per level, in the order they came to it.
<>Place |
    name: ""
    owner: nil
xx
<>Item |
    owner: nil
xx
inn <> Place | name: "the inn"
ana <> Place | name: "Ana", owner: inn
pack <> Place | name: "backpack", owner: ana
rope <> Item | owner: pack
bram <> Place | name: "Bram", owner: inn
:say(:owns_tree(inn))
:say(:owns_tree(rope))
