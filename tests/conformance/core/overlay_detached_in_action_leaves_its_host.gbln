/// known-gap: interp has no block overlay syntax (overlay name ... xx); the interpreter is being retired
/// An overlay put on a parameter inside an action, then taken off that
/// parameter, is gone and its adjustment with it.
<>Polity |
    stability: .8
xx
overlay stunned
    modify
        @stability - .25
    xx
xx
act stun_then_free(target)
    :overlay!(target, stunned, .5)
    :detach!(target, stunned)
end
rome <> Polity | stability: .8
stun_then_free(rome)
say(:overlays_of("rome"))
say(:len(:overlays()))
say(rome >> stability)
