/// known-gap: interp has no decision blocks (decision name ... xx); the interpreter is being retired
/// A decision's judge can call an action written inside the class: it runs
/// with `self` as the deciding object (`self.purchase(shop >> target)`).
<>Shop |
    stock: 0
    sold: 0
xx
<>Buyer |
    spent: 0
    decision shop
        targets: Shop
        score => target >> stock
    xx
    judge
        shop and (shop >> score) > 0: self.purchase(shop >> target)
    xx
    act purchase(target)
        target >> sold |= target >> sold + 1
        self >> spent |= self >> spent + 5
    end
xx
a <> Shop | stock: 10
b <> Buyer | spent: 0
:tick()
:tick()
:say(a >> sold)
:say(b >> spent)
