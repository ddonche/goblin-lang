/// known-gap: interp has no block overlay syntax (overlay name ... xx); the interpreter is being retired
/// Fields an overlay declares (here `kind`) appear on each of its copies.
<>Polity |
    stability: .8
xx
overlay latin
    kind: "language"
    modify
        @stability + .01
    xx
xx
rome <> Polity | stability: .8
:overlay!(rome, latin, .9)
:say(:overlays()[0] >> kind)
:say(:len(:overlays(it >> kind == "language")))
