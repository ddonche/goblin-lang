/// known-gap: interp has no decision blocks (decision name ... xx); the interpreter is being retired
/// Objects a judge arm passes go by reference, as in an ordinary call:
/// `strike(dummy >> target, dummy >> target, self)` changes one dummy twice,
/// and `me` is the fighter itself.
<>Dummy |
    hp: 10
xx
<>Fighter |
    want: 1
    seen: 5
    decision dummy
        targets: Dummy
        score => target >> hp
    xx
    judge
        dummy: strike(dummy >> target, dummy >> target, self)
    xx
xx
act strike(a, b, me)
    a >> hp |= a >> hp - 1
    b >> hp |= b >> hp - 1
    me >> want |= 0
    me >> seen |= me >> want
xx
d <> Dummy | hp: 10
f <> Fighter | want: 1
:tick()
:say(d >> hp)
:say(f >> seen)
