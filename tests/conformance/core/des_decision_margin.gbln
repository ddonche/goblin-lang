/// known-gap: interp has no decision blocks (decision name ... xx); the interpreter is being retired
/// `margin: N` in a decision sets how far below the best score a target may
/// be and still be picked, in the formula's units, for that decision only.
/// Here buying spreads over both shops (stock 10 and 6, margin 5), while visiting,
/// with no margin of its own, uses the object's `margin` (0): only the best.
:rand_seed(3)
<>Shop |
    stock: 0
    sold: 0
    visits: 0
xx
<>Buyer |
    margin: 0
    decision shop
        targets: Shop
        score => target >> stock
        margin: 5
    xx
    decision visit
        targets: Shop
        score => target >> stock
    xx
    judge_all
        shop and (shop >> score) > 0: purchase(self, shop >> target)
        visit and (visit >> score) > 0: drop_in(self, visit >> target)
    xx
xx
act purchase(b, s)
    s >> sold |= s >> sold + 1
xx
act drop_in(b, s)
    s >> visits |= s >> visits + 1
xx
a <> Shop | stock: 10
c <> Shop | stock: 6
repeat 20
    x <> Buyer | margin: 0
xx
tick()
repeat :objects(it >> stock > 0)
    st | it >> stock
    bought | it >> sold > 0
    v | it >> visits
    say("stock {st}: has buyers {bought}, visits {v}")
xx
