/// An overlay applied "for N ticks" modifies its host until N ticks have run.
<>Polity |
    stability: .8
xx
overlay Stunned |
    modifies:
        stability - .25
    end
rome <> Polity | stability: .8
overlay Stunned on rome at .5 for 2 ticks
say(rome >> stability)
tick()
say(rome >> stability)
say(:overlays_of("rome"))
tick()
say(rome >> stability)
say(:overlays_of("rome"))
