/// known-gap: interp has no block overlay syntax (overlay name ... xx); the interpreter is being retired
/// An overlay applied "for N ticks" modifies its host until N ticks have run.
<>Polity |
    stability: .8
xx
overlay stunned
    modify
        @stability - .25
    xx
xx
rome <> Polity | stability: .8
:overlay!(rome, stunned, .5, 2)
:say(rome >> stability)
:tick()
:say(rome >> stability)
:say(:overlays_of("rome"))
:tick()
:say(rome >> stability)
:say(:overlays_of("rome"))
