/// known-gap: interp has no decision blocks (decision name ... xx); the interpreter is being retired
/// A decision's `targets: ... where` and score can call the program's actions. A
/// condition `(target >> owner) == x` only looks at what x holds (its
/// contents list); a condition that doesn't name `target` is checked once.
/// Either way the result is what checking every target gives.
<>Lord |
    name: ""
    gold: 0
    owner: nil
    decision hero
        targets: Knight where (target >> owner) == self and (target >> deeds) > 0
        score => worth(target)
    xx
    decision payer
        targets: Knight where @gold < 5 and (target >> owner) == self
        score => target >> purse
    xx
    judge_all
        hero and (hero >> score) >= 0: pay(self, hero >> target)
        payer and (payer >> score) >= 0: levy(self, payer >> target)
    xx
xx
<>Knight |
    name: ""
    deeds: 0
    purse: 0
    owner: nil
xx
act worth(k)
    return k >> deeds * 10 + k >> purse
xx
act pay(l, k)
    say("{l >> name} rewards {k >> name}")
    l >> gold |= l >> gold - 1
    k >> deeds |= 0
xx
act levy(l, k)
    say("{l >> name} taxes {k >> name}")
    l >> gold |= l >> gold + 3
    k >> purse |= k >> purse - 3
xx
a <> Lord | name: "Ash", gold: 6
b <> Lord | name: "Birch", gold: 2
k1 <> Knight | name: "Kay", deeds: 2, owner: a
k2 <> Knight | name: "Lot", deeds: 3, purse: 4, owner: b
k3 <> Knight | name: "Mark", deeds: 1, purse: 9, owner: a
k4 <> Knight | name: "Nod", purse: 20
tick()
say("{a >> gold} {b >> gold}")
k1 >> owner |= b
tick()
say("{a >> gold} {b >> gold}")
