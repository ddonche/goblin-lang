/// known-gap: interp rescales a formula's scores over a guessed 0..1 range
/// A `~` field read inside a map literal scores the same as a plain read:
/// the cheapest shop scores -10.
<>Shop |
    ~price: 0
    ~sold: 0
xx
<>Buyer |
    hunger: .5
    buy | decision against Shop by [
        0 - {"price": target >> price}{"price"}
    ]
    judge using buy
        >= -10: purchase(target)
        else: browse(target)
    end
xx
act purchase(b, s)
    s >> sold |= s >> sold + 1
xx
act browse(b, s)
    return nil
xx
a <> Shop | price: 30
b <> Shop | price: 10
c <> Shop | price: 20
m <> Buyer | hunger: .5
n <> Buyer | hunger: .5
tick()
repeat :objects(it >> price > 0)
    p | it >> price
    s | it >> sold
    say("price {p}: sold {s}")
xx
