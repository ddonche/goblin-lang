/// known-gap: interp has no block overlay syntax (overlay name ... xx); the interpreter is being retired
/// A `modify` line adjusts what reading gives, never the stored value: when
/// a timed overlay ends only its own adjustment goes, so other changes to
/// the field meanwhile stay, and two overlays on one field can end in
/// either order.
<>F |
    hp: 20
    def: 2
xx
overlay weak
    lasts: 3
    modify
        @hp - 2
    xx
xx
overlay shield
    lasts: 2
    modify
        @def + 3
    xx
xx
overlay blessed
    lasts: 4
    modify
        @def + 1
    xx
xx
a <> F | hp: 20
:overlay!(a, weak)
:overlay!(a, shield)
:overlay!(a, blessed)
repeat :range(1, 6) as d
    a >> hp |= a >> hp - 1
    if d == 1
        a >> def |= a >> def + 10
    xx
    :tick()
    h | a >> hp
    df | a >> def
    :say("tick {d}: hp {h}, def {df}")
xx
