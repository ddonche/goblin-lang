/// known-gap: interp has no block overlay syntax (overlay name ... xx); the interpreter is being retired
/// `:overlays(sick)` gives that overlay's copies, in the order they were
/// put on; `:overlays(sick, pred)` those the predicate holds for;
/// `:overlays(host)` and `:overlays(host, sick)` the copies on one object.
/// An overlay taken off leaves the lists; an unknown overlay name is an
/// error.
<>P |
    n: 0
xx
overlay sick
xx
overlay cold
xx
a <> P | n: 1
b <> P | n: 2
c <> P | n: 3
:overlay!(a, sick, .5)
:overlay!(a, cold, .5)
:overlay!(c, sick, .9)
:say(:len(:overlays(sick)))
:say(:len(:overlays(cold)))
:say(:len(:overlays()))
:say(:len(:overlays(sick, it >> intensity > .6)))
:say(:overlays_of(a))
:say(:len(:overlays(a)))
:say(:len(:overlays(a, cold)))
:say(:len(:overlays(b)))
:say(:overlay_strength("sick", c))
:detach!(a, sick)
:say(:len(:overlays(sick)))
:say(:overlays_of(a))
attempt
    :overlays("sik")
rescue e
    :say("error")
end
