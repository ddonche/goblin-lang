/// known-gap: interp has no decision blocks (decision name ... xx); the interpreter is being retired
/// `order:` compares whole numbers exactly (and `-` turns them round exactly), even past 2^53, where two
/// numbers can look the same as decimals.
<>F |
    name: ""
    key: 0
    decision spot
        targets: T
        score => 1
    xx
    judge
        spot: go(self, spot >> target)
    xx
    order: -@key
xx
<>T |
    n: 0
xx
act go(f, t)
    a | f >> name
    :say("{a}")
xx
t <> T | n: 1
a <> F | name: "lower", key: :int("9007199254740992")
b <> F | name: "higher", key: :int("9007199254740993")
:tick()
