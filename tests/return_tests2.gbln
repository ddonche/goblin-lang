@Player =
    name: "{name}",
    health: 50
    act heal_by(amount)
        health = health + amount
        return health
    xx
end
player1|Player = { name: "Rook", health: 70 }
action apply(list, fn)
    for v in list
        fn(v)
    xx
    return
xx
apply([10, 5], player1.heal_by)
say "Final health: "
say (player1 >> health)