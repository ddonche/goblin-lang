posts | [{"id": 1, "title": "Hello", "body": "World"}, {"id": 2, "title": "Second", "body": "Post"}]
html | :render_template("tests/render_page_repeat.gbln", { "posts": posts })
say(:has(html, "<h1>Posts</h1>"))
say(:has(html, "<h2>Hello</h2>"))
say(:has(html, "<p>World</p>"))
say(:has(html, "<h2>Second</h2>"))
say(:has(html, "<p>Post</p>"))
say "render_template (repeat/it): every line above should be true"
