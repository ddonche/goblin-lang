/// A province: a piece of the map that never moves. People grow toward
/// what the land can feed and move to bordering land with more room. Its
/// settlement (hamlet up to great city) grows and shrinks with its people,
/// its buildings and its trade. `owner` is the polity that holds it.
<>Land |
    name: ..
    x: 0
    y: 0
    terrain: "plain"
    /// How many people the land can feed.
    food: 100.0
    people: 0.0
    /// Growth a year when the land is empty (logistic).
    growth: 0.005
    /// How full the land is before people start to leave.
    crowded: 0.5
    /// The share of people who leave in a year, times how much more room
    /// the new land has.
    leaving: 0.05
    owner: nil
    settlement: "none"
    /// The holder's trade, 0 to 1 (set each year from its trade links).
    trade: 0.0
    granary: 0
    walls: 0
    roads: 0
    temple: 0
    harbour: 0
    library: 0
    /// How much of the world's people hold the idea held most firmly
    /// here (set each year by factions::account).
    dominance: 0.0
    /// This year: a plague or disaster its realm will dread (`struck`), and
    /// famine (`hungry`) (set by overlays::land_year).
    struck: false
    hungry: false
    /// Its place on the map (one number per cell), and how many names have
    /// been drawn here (`name_no`).
    no: 0
    named: 0
    phase: land
        every 1 tick
            @people |= @people + @growth * @people * (1.0 - @people / @food)
            @settlement |= settlement_of(self)
        xx
        decision settle
            targets: Land where :link_score(self, target, "border") and @people >= @crowded * @food
            score => room(target) - room(self)
        xx
        judge
            settle and (settle >> score) > 0: self.move_people(settle >> target, settle >> score)
        xx
    xx
    /// Its tongues and faiths, its weather and disasters, each year
    /// (overlays::land_year; overlays.gbln imports this file, so the
    /// action is named here rather than imported).
    phase: ideas
        every 1 tick
            :invoke("overlays::land_year", self)
        xx
    xx
    act move_people(to, gain)
        /// At most `leaving` of the people go in a year, however much
        /// better the other land is (a land whose harvest failed could
        /// send more people than it had).
        n | @people * @leaving * :min(gain, 1.0)
        before | to >> people
        @people |= @people - n
        to >> people |= to >> people + n
        carry(self, to, n / (before + n))
    xx
xx

/// Shared frontier, from the map: between provinces, and between the
/// polities that hold bordering provinces (set again every year).
link border
    hosts: Land, Tribe, Village, CityState, Kingdom, Empire, NationState, League
    range: bool
xx

/// Settlers bring their tongue and faith: on land `to`, where `share` of
/// the people have just come from `from`, each tongue and faith is held
/// by the settlers' share of what they held and the rest of what was held
/// there (Slavs, Saxons and Bantu spread their speech by settling).
act carry(from, to, share)
    if share < .005 => send nil
    brought | {}
    repeat :overlays(from) as o
        if !(:is_type(o, "Tongue") or :is_type(o, "Faith")) or o >> intensity < .02 => skip
        :update!(brought{o >> overlay_name}, o >> intensity)
    xx
    if :len(brought) == 0 => send nil
    repeat :overlays(to) as o
        if !(:is_type(o, "Tongue") or :is_type(o, "Faith")) => skip
        n | o >> overlay_name
        o >> intensity |= :clamp(o >> intensity * (1.0 - share) + (brought{n} ?? 0.0) * share, 0.0, 1.0)
        :update!(brought{n}, -1.0)
    xx
    repeat brought as n, x
        if x < 0.0 or x * share < .02 => skip
        :overlay!(to, n, x * share)
        repeat :overlays(to, n) as c
            c >> at |= to >> name
        xx
    xx
xx

/// The share of the land's food not yet eaten.
act room(l)
    return 1.0 - (l >> people) / (l >> food)
xx

act buildings(l)
    return l >> granary + l >> walls + l >> roads + l >> temple + l >> harbour + l >> library
xx

/// People, raised a tenth for each building and up to half again by trade.
act settlement_of(l)
    size | (l >> people) * (1.0 + buildings(l) * 0.1) * (1.0 + (l >> trade) * 0.5)
    if size >= 1000.0 => send "great city"
    if size >= 500.0 => send "city"
    if size >= 200.0 => send "town"
    if size >= 50.0 => send "village"
    if size >= 1.0 => send "hamlet"
    return "none"
xx

act is_city(l)
    s | l >> settlement
    return s == "city" or s == "great city"
xx

/// Whether the world runs in regions (set by history.gbln before it hands
/// the world out): then a new object is placed next to what it belongs to.
in_regions | false

act use_regions()
    in_regions |= true
xx

/// Runs `o` where `near` runs (a no-op without regions, or when it already
/// runs there).
act place(o, near)
    if in_regions and !near.nix? => :move!(o, near)
xx

/// The world's clock: the year, which the program sets as each year
/// begins (`set_year`), and how many cells the map has. It is an object,
/// so every region reads the same year.
<>Clock |
    year: 0
    cells: 1
    /// Years of dimmed sun left, this year's weather (the harvest lost in
    /// each sixth of the map, "x,y"), and last year's share of all the
    /// world's people holding each tongue and faith (`spread`) and how much
    /// each faith seeks converts (`seeks`), by name: what every region
    /// reads, set by the program each year (overlays::prepare, account).
    cold: 0
    weather: {}
    spread: {}
    seeks: {}
xx

clock <> Clock | year: 0, cells: 1

act year()
    return clock >> year
xx

act set_year(y)
    clock >> year |= y
xx

act set_cells(n)
    clock >> cells |= n
xx

act cold()
    return clock >> cold
xx

act weather(key)
    return (clock >> weather){key} ?? 0.0
xx

act spread(n)
    return (clock >> spread){n} ?? 0.0
xx

act seeks(n)
    return (clock >> seeks){n} ?? 0.0
xx

act set_world(cold, weather)
    if clock >> cold != cold => clock >> cold |= cold
    clock >> weather |= weather
xx

act faith_seeks()
    return clock >> seeks
xx

act set_ideas(spread, seeks)
    clock >> spread |= spread
    clock >> seeks |= seeks
xx

/// A number no name drawn anywhere else has had: the province's place on
/// the map, then once round the map again for each name drawn here. A name
/// drawn for a realm, a house or a person draws it at the realm's capital,
/// so two regions never draw the same one.
act name_no(l)
    n | l >> named
    l >> named |= n + 1
    return l >> no + n * (clock >> cells)
xx
