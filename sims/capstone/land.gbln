/// A province: a piece of the map that never moves. People grow toward
/// what the land can feed and move to bordering land with more room. Its
/// settlement (hamlet up to great city) grows and shrinks with its people,
/// its buildings and its trade. `owner` is the polity that holds it.
<>Land |
    name: ..
    x: 0
    y: 0
    terrain: "plain"
    /// How many people the land can feed.
    food: 100.0
    people: 0.0
    /// Growth a year when the land is empty (logistic).
    growth: 0.005
    /// How full the land is before people start to leave.
    crowded: 0.5
    /// The share of people who leave in a year, times how much more room
    /// the new land has.
    leaving: 0.05
    owner: nil
    settlement: "none"
    /// The holder's trade, 0 to 1 (set each year from its trade links).
    trade: 0.0
    granary: 0
    walls: 0
    roads: 0
    temple: 0
    harbour: 0
    library: 0
    /// How much of the world's people hold the idea held most firmly
    /// here (set each year by factions::account).
    dominance: 0.0
    phase: land
        every 1 tick
            @people |= @people + @growth * @people * (1.0 - @people / @food)
            @settlement |= settlement_of(self)
        xx
        decision settle
            targets: Land where :link_score(self, target, "border") and @people >= @crowded * @food
            score => room(target) - room(self)
        xx
        judge
            settle and (settle >> score) > 0: self.move_people(settle >> target, settle >> score)
        xx
    xx
    act move_people(to, gain)
        /// At most `leaving` of the people go in a year, however much
        /// better the other land is (a land whose harvest failed could
        /// send more people than it had).
        n | @people * @leaving * :min(gain, 1.0)
        before | to >> people
        @people |= @people - n
        to >> people |= to >> people + n
        carry(self, to, n / (before + n))
    xx
xx

/// Shared frontier, from the map: between provinces, and between the
/// polities that hold bordering provinces (set again every year).
link border
    hosts: Land, Tribe, Village, CityState, Kingdom, Empire, NationState, League
    range: bool
xx

/// Settlers bring their tongue and faith: on land `to`, where `share` of
/// the people have just come from `from`, each tongue and faith is held
/// by the settlers' share of what they held and the rest of what was held
/// there (Slavs, Saxons and Bantu spread their speech by settling).
act carry(from, to, share)
    if share < .005 => send nil
    brought | {}
    repeat :overlays(from) as o
        if !(:is_type(o, "Tongue") or :is_type(o, "Faith")) or o >> intensity < .02 => skip
        :update!(brought{o >> overlay_name}, o >> intensity)
    xx
    if :len(brought) == 0 => send nil
    repeat :overlays(to) as o
        if !(:is_type(o, "Tongue") or :is_type(o, "Faith")) => skip
        n | o >> overlay_name
        o >> intensity |= :clamp(o >> intensity * (1.0 - share) + (brought{n} ?? 0.0) * share, 0.0, 1.0)
        :update!(brought{n}, -1.0)
    xx
    repeat brought as n, x
        if x < 0.0 or x * share < .02 => skip
        :overlay!(to, n, x * share)
        repeat :overlays(to, n) as c
            c >> at |= to >> name
        xx
    xx
xx

/// The share of the land's food not yet eaten.
act room(l)
    return 1.0 - (l >> people) / (l >> food)
xx

act buildings(l)
    return l >> granary + l >> walls + l >> roads + l >> temple + l >> harbour + l >> library
xx

/// People, raised a tenth for each building and up to half again by trade.
act settlement_of(l)
    size | (l >> people) * (1.0 + buildings(l) * 0.1) * (1.0 + (l >> trade) * 0.5)
    if size >= 1000.0 => send "great city"
    if size >= 500.0 => send "city"
    if size >= 200.0 => send "town"
    if size >= 50.0 => send "village"
    if size >= 1.0 => send "hamlet"
    return "none"
xx

act is_city(l)
    s | l >> settlement
    return s == "city" or s == "great city"
xx
