/// A province: a piece of the map that never moves. People grow toward
/// what the land can feed and move to bordering land with more room. A
/// province a kingdom owns may make war on a bordering province of another
/// realm, in a year with odds of `war_rate`, when its kingdom is at least
/// `boldness` times as likely to win as to lose.
import kingdom as kingdom

<>Land |
    x: 0
    y: 0
    terrain: "plain"
    /// How many people the land can feed.
    food: 100.0
    people: 0.0
    /// Growth a year when the land is empty (logistic).
    growth: 0.005
    /// How full the land is before people start to leave.
    crowded: 0.5
    /// The share of people who leave in a year, times how much more room
    /// the new land has.
    leaving: 0.05
    owner: nil
    war_rate: 0.02
    boldness: 1.5
    /// The share of each side's people a war kills.
    war_loss: 0.05
    /// How hard a province with no kingdom holds out, per person.
    free_cohesion: 0.2
    every 1 tick
        @people |= @people + @growth * @people * (1.0 - @people / @food)
    xx
    decision settle
        targets: Land where :link_score(self, target, "border") and @people >= @crowded * @food
        score => room(target) - room(self)
    xx
    decision invade
        targets: Land where :link_score(self, target, "border") and @owner != nil and kingdom::realm(target >> owner) != kingdom::realm(@owner)
        score => kingdom::odds(self, target, target >> free_cohesion)
    xx
    judge_all
        settle and (settle >> score) > 0: self.move_people(settle >> target, settle >> score)
        invade and (invade >> score) * (1.0 + @boldness) > @boldness and (pick 1 from 0...9999) < @war_rate * 10000.0: kingdom::war(self, invade >> target, invade >> score, @war_loss)
    xx
    act move_people(to, gain)
        n | @people * @leaving * gain
        @people |= @people - n
        to >> people |= to >> people + n
    xx
xx

link border
    hosts: Land
    range: bool
xx

/// The share of the land's food not yet eaten.
act room(l)
    return 1.0 - (l >> people) / (l >> food)
xx
