/// Capstone step 3: forms of government. A polity's form is one member of
/// the Government overlay class; putting on another replaces it. Each form
/// is described by its fields (who rules, what a polity needs to have it,
/// how well it suits one, what it can become), and the code below reads
/// those fields and never a form's name, so a new form works with no code
/// change. A form
/// bends some traits (a `+` is .1, a `++` .2) and leans some decisions
/// (their weight is multiplied by its `lean_` field, 1 unless a form
/// raises it by .5 or lowers it). A bend is on top of the trait: the
/// trait's own value is its culture, which the yearly pull works on, so
/// the bend lasts while the form does and goes with it. The forms change in the settle phase, by chance
/// from the state (`regime`); a form a polity can't have is replaced by
/// rule (`choose`).

<^>Government |
    hosts: Tribe, Village, CityState, Kingdom, Empire, NationState, League
    dup: replace
    /// Who rules: "crown", "usurper", "junta", "priest", "term" (holders
    /// chosen for a term), "client" (placed by an overlord) or "none".
    rule: "none"
    /// The law a crown under it follows when not inherited ("elective").
    law: ..
    /// Years a holder chosen for a term serves.
    term: 4
    /// What a polity needs to have it: one of these ranks, a city, an
    /// overlord; whether a realm, and a league, can have it.
    ranks: [1, 2, 3, 4, 5, 6]
    city: false
    overlord: false
    realms: true
    leagues: false
    /// Whether a polity can take it by rule (`choose`, `keep`), rather than
    /// only from what happens to it.
    chosen: true
    /// How well it suits a polity: the product of these traits, and of
    /// one minus each of `fit_down` (0 with neither).
    fit_up: []
    fit_down: []
    /// The forms that carry it on when a polity can't keep it.
    carries_on: []
    /// Whether it is a republic (the revolution's aim), and whether a
    /// constitution binds its crown (it ends dividing the realm).
    republic: false
    constitution: false
    /// Whether no ruler is accepted and rivals contend for the throne.
    contested: false
    /// What it can become, by kind of change (see `regime`).
    becomes: {}
xx

/// The heads of families.
overlay elders_council <^> Government
    rule: "none"
    ranks: [1, 2]
    fit_up: ["cohesion", "tradition"]
    carries_on: ["aristocratic_republic", "elective_monarchy"]
    becomes: {"coup": ["military_junta"], "usurper": ["tyranny"], "takeover": ["theocracy"], "trade": ["merchant_oligarchy"], "strongman": ["chieftainship"]}
    modify
        @cohesion + .1
        @tradition + .1
        @ambition - .1
        @lean_envoy + .5
        @lean_treaty + .5
    xx
xx
/// One chief by strength or kin.
overlay chieftainship <^> Government
    rule: "none"
    ranks: [1, 2]
    fit_up: ["aggression"]
    fit_down: ["cooperation"]
    carries_on: ["hereditary_monarchy"]
    becomes: {"coup": ["military_junta"], "usurper": ["tyranny"], "takeover": ["theocracy"], "chief_dies": ["elders_council"]}
    modify
        @aggression + .1
        @stability - .1
        @lean_raid + .5
        @lean_strike + .5
        @lean_ally + .5
    xx
xx
/// A dynasty: steadier while the line is secure, shakier when it is not.
overlay hereditary_monarchy <^> Government
    rule: "crown"
    ranks: [3, 4, 5, 6]
    fit_up: ["tradition", "legitimacy"]
    carries_on: ["chieftainship"]
    becomes: {"coup": ["military_junta"], "usurper": ["tyranny"], "revolution": ["aristocratic_republic", "citizen_republic"], "takeover": ["theocracy"], "reform": ["constitutional_monarchy"], "empire": ["imperial_autocracy"]}
    modify
        @stability + .2 * (@succession - .5)
        @lean_war + .5
        @lean_match + .5
    xx
xx
/// A ruler chosen by the great families.
overlay elective_monarchy <^> Government
    rule: "crown"
    law: "elective"
    ranks: [3, 4, 5, 6]
    fit_up: ["cooperation"]
    fit_down: ["centralization"]
    carries_on: ["elders_council"]
    becomes: {"harden": ["hereditary_monarchy"], "coup": ["military_junta"], "usurper": ["tyranny"], "revolution": ["aristocratic_republic", "citizen_republic"], "takeover": ["theocracy"], "reform": ["constitutional_monarchy"], "empire": ["imperial_autocracy"]}
    modify
        @legitimacy + .1
        @centralization - .1
    xx
xx
/// Priests, or a ruler who is the faith.
overlay theocracy <^> Government
    rule: "priest"
    ranks: [2, 3, 4, 5, 6]
    fit_up: ["spirituality", "spirituality"]
    becomes: {"coup": ["military_junta"], "usurper": ["tyranny"], "secular": ["hereditary_monarchy", "elective_monarchy", "aristocratic_republic", "citizen_republic", "elders_council"]}
    modify
        @spirituality + .1
        @openness - .1
        @tolerance - .1
    xx
xx
/// Rich families and guilds.
overlay merchant_oligarchy <^> Government
    rule: "term"
    term: 6
    city: true
    fit_up: ["openness"]
    fit_down: ["honor"]
    becomes: {"lords": ["hereditary_monarchy", "tyranny"], "coup": ["military_junta"], "usurper": ["tyranny"], "takeover": ["theocracy"]}
    modify
        @openness + .1
        @honor - .1
        @aggression - .1
        @lean_trade + .5
        @lean_embargo + .5
    xx
xx
/// A council of nobles.
overlay aristocratic_republic <^> Government
    rule: "term"
    term: 10
    ranks: [3, 4, 5, 6]
    republic: true
    fit_up: ["tradition"]
    fit_down: ["centralization"]
    carries_on: ["elders_council"]
    becomes: {"coup": ["military_junta"], "usurper": ["tyranny"], "falls": ["tyranny", "military_junta"], "takeover": ["theocracy"], "trade": ["merchant_oligarchy"]}
    modify
        @stability + .1
        @centralization - .1
        @lean_treaty + .5
        @lean_league + .5
    xx
xx
/// An assembly of citizens.
overlay citizen_republic <^> Government
    rule: "term"
    ranks: [3, 6]
    republic: true
    fit_up: ["cooperation", "openness"]
    carries_on: ["aristocratic_republic"]
    becomes: {"coup": ["military_junta"], "usurper": ["tyranny"], "falls": ["tyranny", "military_junta"], "takeover": ["theocracy"], "trade": ["merchant_oligarchy"]}
    modify
        @cooperation + .1
        @discipline - .1
        @openness + .1
        @lean_treaty + .5
        @lean_league + .5
        @lean_settle + .5
    xx
xx
/// A usurper ruling without law.
overlay tyranny <^> Government
    rule: "usurper"
    city: true
    fit_up: ["fear"]
    fit_down: ["legitimacy"]
    becomes: {"coup": ["military_junta"], "revolution": ["aristocratic_republic", "citizen_republic"], "takeover": ["theocracy"]}
    modify
        @fear + .1
        @legitimacy - .1
        @stability - .1
        @lean_war + .5
    xx
xx
/// The army's officers.
overlay military_junta <^> Government
    rule: "junta"
    ranks: [3, 4, 5, 6]
    fit_up: ["discipline", "aggression"]
    fit_down: ["legitimacy"]
    becomes: {"lords": ["hereditary_monarchy", "tyranny"], "usurper": ["tyranny"], "revolution": ["aristocratic_republic", "citizen_republic"], "takeover": ["theocracy"]}
    modify
        @discipline + .1
        @aggression + .1
        @legitimacy - .1
        @lean_strike + .5
        @lean_levy + .5
    xx
xx
/// An emperor over a bureaucracy.
overlay imperial_autocracy <^> Government
    rule: "crown"
    ranks: [5]
    fit_up: ["centralization", "ambition"]
    carries_on: ["hereditary_monarchy"]
    becomes: {"coup": ["military_junta"], "usurper": ["tyranny"], "revolution": ["aristocratic_republic", "citizen_republic"], "takeover": ["theocracy"]}
    modify
        @centralization + .1
        @ambition + .1
        @lean_demand + .5
    xx
xx
/// Members keep their own rule and share defence: a league's form.
overlay confederation <^> Government
    realms: false
    leagues: true
    fit_up: ["cooperation"]
    becomes: {"coup": ["military_junta"], "usurper": ["tyranny"], "takeover": ["theocracy"]}
    modify
        @cooperation + .1
        @centralization - .2
        @lean_ally + .5
        @lean_trade + .5
    xx
xx
/// A crown bound by law and an assembly.
overlay constitutional_monarchy <^> Government
    rule: "crown"
    ranks: [6]
    constitution: true
    fit_up: ["legitimacy", "cooperation"]
    carries_on: ["hereditary_monarchy"]
    becomes: {"coup": ["military_junta"], "usurper": ["tyranny"], "revolution": ["aristocratic_republic", "citizen_republic"], "takeover": ["theocracy"]}
    modify
        @stability + .1
        @legitimacy + .1
        @lean_treaty + .5
        @lean_ally + .5
    xx
xx
/// Rulers placed or kept by an overlord.
overlay client_regime <^> Government
    rule: "client"
    overlord: true
    chosen: false
    becomes: {"coup": ["military_junta"], "usurper": ["tyranny"], "takeover": ["theocracy"]}
    modify
        @legitimacy - .1
        @lean_revolt - .5
    xx
xx
/// No accepted ruler; rivals contend.
overlay interregnum <^> Government
    contested: true
    leagues: true
    chosen: false
    becomes: {"restore": ["hereditary_monarchy", "elective_monarchy"], "coup": ["military_junta"], "usurper": ["tyranny"], "takeover": ["theocracy"]}
    modify
        @stability - .2
        @fear + .1
    xx
xx

/// The forms, by name (an overlay is an object: `:objects(Government)`
/// gives each, with its fields).
kinds | {}
forms | []
repeat :objects(Government) as g
    :update!(kinds{g >> overlay_name}, g)
    :put_last!(forms, g >> overlay_name)
xx

/// Form `f` (a name), or nil. A form made while the program runs is
/// found too.
act form(f)
    if f.nix? or f == .. => send nil
    g | kinds{f}
    if !g.nix? => send g
    repeat :objects(Government) as k
        if k >> overlay_name == f => send k
    xx
    return nil
xx

/// Field `field` of form `f`, or `none` when there is no such form.
act of(f, field, none)
    g | form(f) ?? => send none
    return :field(g, field)
xx

/// The first form whose field `field` holds `v` (the client regime for
/// rule "client", the league's form for leagues), or nil.
act first_where(field, v)
    repeat :objects(Government) as g
        if :field(g, field) == v => send g >> overlay_name
    xx
    return nil
xx

/// The form a polity's overlord sets up, a league takes, or a realm
/// falls into with no accepted ruler.
act client_form()
    return first_where("rule", "client")
xx
act league_form()
    return first_where("realms", false)
xx
act contested_form()
    return first_where("contested", true)
xx

/// Who rules under form `f` ("none" with no form).
act rule_of(f)
    return of(f, "rule", "none")
xx

/// Whether form `f` leaves the throne contested.
act contested(f)
    return of(f, "contested", false)
xx

/// The form of government on `p`, or nil.
act form_of(p)
    repeat :overlays_of(p) as o
        if :has(forms, o) => send o
    xx
    return nil
xx

/// How far `v` is past `at` toward 1: 0 at `at` or below, 1 at 1.
act past(v, at)
    return :clamp((v - at) / (1.0 - at), 0.0, 1.0)
xx

/// How far `v` is under `at` toward 0: 0 at `at` or above, 1 at 0.
act under(v, at)
    return :clamp((at - v) / at, 0.0, 1.0)
xx

/// Whether `p` can have form `f` (the plan's "Allowed at").
act allowed(p, f)
    g | form(f) ?? => send false
    if :is_type(p, "League") => send g >> leagues
    if !(g >> realms) => send false
    if !:has(g >> ranks, p >> rank) => send false
    if g >> city and p >> cities < 1 => send false
    if g >> overlord and (p >> owner).nix? => send false
    return true
xx

/// How well form `f` suits `p`'s traits, for a polity that takes a new
/// form by rule: the product of its `fit_up` traits and of one minus each
/// `fit_down` trait (0 with neither).
act fit(p, f)
    g | form(f) ?? => send 0.0
    if :len(g >> fit_up) == 0 and :len(g >> fit_down) == 0 => send 0.0
    w | 1.0
    repeat g >> fit_up as t
        w |= w * (p >> {t})
    xx
    repeat g >> fit_down as t
        w |= w * (1.0 - p >> {t})
    xx
    return w
xx

/// A form drawn by fit among those `p` can have (only forms taken by
/// rule: a client regime or an interregnum comes from what happens to it).
act choose(p)
    names   | []
    weights | []
    repeat forms as f
        if !of(f, "chosen", false) => skip
        if !allowed(p, f) => skip
        w | fit(p, f)
        if w <= 0.0 => skip
        :put_last!(names, f)
        :put_last!(weights, w)
    xx
    if :len(names) == 0 => send nil
    return :sample_weighted({"src": names, "weights": weights})[0]
xx

/// The form a successor of a polity under form `f` takes (a split's
/// halves, a union, a polity that rose or fell a class): `f` if it can
/// have it, else one drawn by fit, the forms that carry `f` on (its
/// `carries_on`) weighing .5 more.
act keep(p, f)
    if !f.nix? and f != .. and allowed(p, f) => send f
    names   | []
    weights | []
    near | of(f, "carries_on", [])
    repeat forms as g
        if !of(g, "chosen", false) or !allowed(p, g) => skip
        w | fit(p, g)
        if :has(near, g) => w |= w + .5
        if w <= 0.0 => skip
        :put_last!(names, g)
        :put_last!(weights, w)
    xx
    if :len(names) == 0 => send nil
    return :sample_weighted({"src": names, "weights": weights})[0]
xx

/// Puts form `f` on `p` (it replaces the form before).
act rule(p, f)
    if f.nix? => send nil
    :overlay!(p, f)
xx

/// How many rulers of its ruling house `p`'s throne has seen (0 with no
/// house).
act held(p)
    d | p >> dynasty ?? => send 0
    return d >> rulers
xx

/// The crown a contested throne ends in, among `fs`, drawn by fit; each
/// claim on the throne (up to three) adds .3 to a crown passed by birth
/// (one with no `law` of its own).
act restored(p, fs)
    names | []
    weights | []
    repeat fs as f
        w | fit(p, f)
        if of(f, "law", ..) == .. => w |= w + .3 * :min(p >> claimants, 3)
        :put_last!(names, f)
        :put_last!(weights, w + .01)
    xx
    return :sample_weighted({"src": names, "weights": weights})[0]
xx

/// One of `fs` that `p` can have, drawn by fit, or nil.
act one_of(p, fs)
    names   | []
    weights | []
    repeat fs as f
        if !allowed(p, f) => skip
        :put_last!(names, f)
        :put_last!(weights, fit(p, f) + .01)
    xx
    if :len(names) == 0 => send nil
    return :sample_weighted({"src": names, "weights": weights})[0]
xx

/// The kinds of change a form can go through, in the order they are
/// weighed, and the chance of each this year. A form says which it can go
/// through, and into what (`becomes`); one target is taken as it is,
/// several are drawn (`restore` by `restored`, the others by fit).
changes | ["restore", "harden", "lords", "coup", "usurper", "revolution", "falls", "takeover", "secular", "reform", "empire", "trade", "strongman", "chief_dies"]

act odds(p, c, lost, won, armed, unpaid)
    judge
        /// A claimant wins: by right of birth the likelier the more houses
        /// claim the throne, else by the great families' choice.
        c == "restore": send (p >> cohesion) * past(p >> legitimacy, .2)
        /// A house that has held the throne for generations makes it
        /// hereditary.
        c == "harden": send past(:min(held(p) / 6.0, 1.0), .3) * past(p >> centralization, .4) * .2
        /// One of the rich families makes itself lord.
        c == "lords": send past(p >> ambition, .5) * under(p >> cooperation, .5) * (.5 + .5 * :min(p >> wars, 1))
        /// A coup.
        /// In real life an army takes power where it is large against the
        /// realm and the crown's right is doubted, mostly after a defeat,
        /// or when it goes unpaid (a group of officers who plot try at once:
        /// factions::coup).
        /// A large army can also topple a ruler whose right nobody doubts
        /// (Rome's praetorians); a disciplined, professional army less
        /// often; a contested succession invites it. One coup invites the
        /// next (the coup trap: Londregan and Poole).
        c == "coup": send past(armed, .1) * :max(under(p >> legitimacy, .6), .3 * past(armed, .5)) * (.1 + .9 * :max(lost, unpaid)) * (1.5 - p >> discipline) * (1.5 - p >> succession) * (1.0 + 2.0 * :min(p >> coups, 1.0))
        /// A usurper.
        c == "usurper": send under(p >> legitimacy, .4) * past(p >> fear, .5) * past(p >> ambition, .5) * (1.5 - p >> succession)
        /// A revolution.
        c == "revolution": send past(p >> learning, .3) * past(p >> openness, .5) * :min(2.0 * (p >> cities) / :max(p >> lands, 1), 1.0) * under(p >> legitimacy, .6)
        /// The republic falls.
        c == "falls": send (:overlay_strength("war_weariness", p) ?? 0.0) * under(p >> stability, .5) * (.5 + .5 * won)
        /// A religious takeover.
        /// In real life priests rule only where the faith's men are the
        /// strongest power in the land and the crown is weak: a devout,
        /// intolerant people alone is not enough.
        c == "takeover": send past(p >> spirituality, .7) * under(p >> tolerance, .5) * past(p >> clergy, .4) * under(p >> legitimacy, .5)
        /// Secularization.
        /// Secularization, or the lords taking the rule back from priests
        /// whose hold has slipped.
        c == "secular": send :max(past(p >> learning, .2) * :min((p >> gold) / ((p >> people) * .05 + 1.0), 1.0) * (1.0 - p >> spirituality), under(p >> clergy, .3) * .05)
        /// Reform or concession.
        c == "reform": send past(p >> cooperation, .5) * past(p >> learning, .4)
        /// An empire's crown over a bureaucracy (not in the plan's table).
        c == "empire": send past(p >> centralization, .6) * past(p >> ambition, .5)
        /// Trade makes the rich families rule (not in the plan's table).
        c == "trade": send past(:min((p >> commerce) / 3.0, 1.0), .3) * past(p >> openness, .5)
        /// A strong leader rises.
        c == "strongman": send past(p >> aggression, .5) * (.2 + .8 * :min(p >> wars, 1))
        /// The chief dies and the families take back the rule.
        c == "chief_dies": send (1.0 - :min(p >> wars, 1)) * under(p >> aggression, .6) * (p >> cohesion)
    xx
    return 0.0
xx

/// What the state needs for change `c` to be possible at all.
act possible(p, c)
    judge
        c == "lords" or c == "coup": send p >> rank >= 3
        c == "usurper": send p >> cities >= 1
        c == "takeover": send p >> rank >= 2
    xx
    return true
xx

/// The year's change of form, if any. Each change the form can go
/// through and the state makes possible has a chance this year (how far
/// past its conditions the polity is); one draw takes at most one of them,
/// and nothing changes with the chance left over. A form `p` can't have
/// is replaced by rule. `lost`, `won`: whether it lost or won a war
/// lately; `armed`: its army against its people; `unpaid`: an army it
/// can't pay.
act regime(p, lost, won, armed, unpaid)
    f | form_of(p)
    if f.nix? or !allowed(p, f)
        rule(p, choose(p))
        send nil
    xx
    becomes | of(f, "becomes", {})
    into | []
    odds_of | []
    repeat changes as c
        fs | becomes{c} ?? => skip
        if !possible(p, c) => skip
        judge
            :len(fs) == 1: :put_last!(into, fs[0])
            c == "restore": :put_last!(into, restored(p, fs))
            true: :put_last!(into, one_of(p, fs))
        xx
        :put_last!(odds_of, odds(p, c, lost, won, armed, unpaid))
    xx
    names   | []
    weights | []
    left    | 1.0
    repeat :range(0, :len(into)) as i
        g | into[i]
        c | :min(odds_of[i], .9)
        if g.nix? or g == f or c <= 0.0 or !allowed(p, g) => skip
        :put_last!(names, g)
        :put_last!(weights, c)
        left |= left - c
    xx
    if :len(names) == 0 => send nil
    :put_last!(names, "")
    :put_last!(weights, :max(left, 0.0))
    g | :sample_weighted({"src": names, "weights": weights})[0]
    if g != "" => rule(p, g)
xx
