                owner: nil
                age: 0
                wars: 0
                peoples: 1
                beaten_by: nil
                submits_to: nil
                union_with: nil
                colony_at: nil
                lost_years: 0
                won_years: 0
                prestige: 0.0
                debt: 0.0
                gold: @gold * (@rebel >> people) / (@people + 1.0)
                army: @army * (@rebel >> people) / (@people + 1.0)
                food: @food * (@rebel >> people) / (@people + 1.0)
            xx
            carries:
                gold: @gold * (1.0 - (@rebel >> people) / (@people + 1.0))
                army: @army * (1.0 - (@rebel >> people) / (@people + 1.0))
                food: @food * (1.0 - (@rebel >> people) / (@people + 1.0))
            xx
        xx
        transition fracture where chance(breakaway(self, false))
            into: Kingdom
            fragment:
                name: next_name()
                rank: 4
                owner: nil
                age: 0
                wars: 0
                peoples: 1
                beaten_by: nil
                submits_to: nil
                union_with: nil
                colony_at: nil
                lost_years: 0
                won_years: 0
                prestige: 0.0
                debt: 0.0
                gold: @gold * (@rebel >> people) / (@people + 1.0)
                army: @army * (@rebel >> people) / (@people + 1.0)
                food: @food * (@rebel >> people) / (@people + 1.0)
            xx
            carries:
                gold: @gold * (1.0 - (@rebel >> people) / (@people + 1.0))
                army: @army * (1.0 - (@rebel >> people) / (@people + 1.0))
                food: @food * (1.0 - (@rebel >> people) / (@people + 1.0))
            xx
        xx
        uses founding
        uses conquest
        uses unification
    xx
xx
<>NationState |
    uses Polity
    uses downfall, breakup, regime
    rank: 6
    ~cohesion: .75
    ~legitimacy: .65
    ~discipline: .65
    ~centralization: .75
