/// Capstone steps 2 and 3: polities. Seven classes share one aspect
/// (`Polity`, every trait and resource) and three interfaces: `govern`
/// (decisions toward its own provinces) and `realm` (toward its own shape:
/// reform, settle, migrate, union, cede, release, revolt), both in the
/// inside phase, and `dealings` (toward other polities, in the between
/// phase). Each judge draws one decision a year by weight among the
/// possible ones: a decision is possible when its `where` holds, and its
/// score is its weight. A War is an object that fights each year in the
/// between phase. In the settle phase each polity's form of government
/// may change (`government.gbln`) and its class's transitions may fire,
/// each with a chance a year that rises the further past its conditions
/// the polity is.
import land as land
import government as government
import family as family
import factions as factions
import overlays as overlays

aspect Polity |
    name: ..
    /// 1 tribe, 2 village community, 3 city-state, 4 kingdom, 5 empire,
    /// 6 nation-state; set by the class.
    rank: 1
    founded: 0
    owner: nil
    capital: nil
    cx: 0
    cy: 0
    /// Every how many provinces from the capital its strength halves.
    reach: 4.0
    /// Each trait's baseline (its culture), set when it is founded. A
    /// form of government bends a trait and its baseline together.
    base_aggression: .5
    base_cooperation: .5
    base_fear: .5
    base_ambition: .5
    base_cohesion: .5
    base_stability: .5
    base_succession: .5
    base_honor: .5
    base_spirituality: .5
    base_openness: .5
    base_discipline: .5
    base_legitimacy: .5
    base_centralization: .5
    base_tolerance: .5
    base_tradition: .5
    base_learning: .5
    /// How a form of government weighs each of these decisions (1 is as
    /// the traits have it).
    lean_trade: 1.0
    lean_envoy: 1.0
    lean_aid: 1.0
    lean_ally: 1.0
    lean_treaty: 1.0
    lean_embargo: 1.0
    lean_demand: 1.0
    lean_raid: 1.0
    lean_strike: 1.0
    lean_war: 1.0
    lean_levy: 1.0
    lean_settle: 1.0
    lean_league: 1.0
    lean_revolt: 1.0
    lean_match: 1.0
    /// Its ruler, its ruling dynasty and succession law, its ruling
    /// family as numbers (the heir's age, -1 for none; other kin who
    /// could contend), how many claims other houses hold on it, whether
    /// a divided succession owes a son a share, the years left of a term
    /// leader's term, the form of government its ruler was seated under,
    /// and how many rulers have had each name.
    ruler: nil
    dynasty: nil
    law: ..
    heir: -1
    kin: 0
    claimants: 0
    partition: false
    term: 0
    seated: ..
    reigns: {}
    /// Years since it was founded (as this polity).
    age: 0
    /// Its form of government and the years it has had it.
    form: ..
    form_years: 0
    /// Years since it last won or lost a war (counting down from 10).
    won_years: 0
    lost_years: 0
    /// The polity that broke it in a war (it may take or subjugate it).
    beaten_by: nil
    /// The polity it agreed to serve when it met a demand.
    submits_to: nil
    /// The polity it agreed a union with.
    union_with: nil
    /// The free province it means to settle.
    colony_at: nil
    /// Its province likeliest to break away: far from the capital, peopled.
    rebel: nil
    /// Settled free provinces bordering its land.
    frontier: 0
    /// Tongues spoken by at least 15% of its people (set each year by
    /// overlays::account).
    peoples: 1
    /// For a League: its members, and the years one member has held more
    /// than half of the members' land.
    members: 0
    dominance: 0
    lands: 0
    cities: 0
    coast: 0
    wars: 0
    commerce: 0.0
    strength: 0.0
    harvest: 0.0
    power: 0.0
    best: nil
    ~aggression: .5
    ~cooperation: .5
    ~fear: .5
    ~ambition: .5
    ~cohesion: .5
    ~stability: .5
    ~succession: .5
    ~honor: .5
    ~spirituality: .5
    ~openness: .5
    ~discipline: .5
    ~legitimacy: .5
    ~centralization: .5
    ~tolerance: .5
    ~tradition: .5
    ~learning: .1
    people: 0.0
    food: 0.0
    gold: 0.0
    iron: 0.0
    wood: 0.0
    stone: 0.0
    horses: 0.0
    ships: 0.0
    army: 0.0
    relics: 0.0
    prestige: 0.0
    debt: 0.0
    /// What its people's ideas pull its culture toward, by trait (set each
    /// year by factions::account).
    bends: {}
    /// This year's coup plotting and unrest stirred by its factions.
    plot: 0.0
    unrest: 0.0
    /// The strongest group of believers' hold on the realm this year
    /// (its power times its zeal, 0 to 1; set by factions::account).
    clergy: 0.0
xx

/// What every class but League shares when it changes shape. Each
/// interface holds the transitions one cause brings and the code run right
/// after them; a class takes them with `uses`, and they run where it writes
/// it. Transitions that turn a polity into a given class (mutate into
/// Kingdom) stay in that class.
///
/// founding: a colony settled (realm `settle`) and a league formed.
interface founding |
    transition spawn where !(@colony_at.nix?)
        into: Village
        child:
            name: next_name()
        xx
    xx
    transition spawn where chance(league_odds(self))
        into: League
        child:
            name: next_name()
        xx
    xx
    on spawn => founded_child(self, child)
xx

/// conquest: what a war won brings (dealings `war`).
interface conquest |
    transition absorb
        targets: uses govern where (target >> beaten_by) == self and chance(annex_odds(self, target))
        overlays: drop
        links: reset
    xx
    transition subjugate
        targets: uses govern where ((target >> submits_to) == self or (target >> beaten_by) == self) and (target >> owner).nix? and top(self) != target and chance(vassal_odds(self, target))
    xx
    on absorb => annexed(self, target)
    on subjugate => vassal_made(self, target)
xx

/// unification: two realms made one (realm `union`).
interface unification |
    transition merge
        targets: uses govern where (target >> union_with) == self and @union_with == target
        overlays: drop
        carries:
            name: "{@name}-{target >> name}"
            wars: 0
        xx
    xx
    on merge => united(self, target, merged)
xx

/// downfall: a polity with no land left is gone.
interface downfall |
    transition erase where @lands == 0
    on erase => fallen(self)
xx

/// breakup: the land shared out after a split or a breakaway; the split
/// and fracture transitions themselves are each class's own.
interface breakup |
    on split => divided(self, first, second)
    on fracture => broke_away(self, fragment)
xx

/// regime: a new form of government when the class changes.
interface regime |
    on mutate => mutated(self)
xx

<>Tribe |
    uses Polity
    uses downfall, breakup, regime
    rank: 1
    ~aggression: .6
    ~cohesion: .7
    ~tradition: .7
    ~legitimacy: .6
    ~openness: .35
    ~discipline: .3
    ~centralization: .1
    ~learning: .02
    phase: inside
        uses govern
        uses answers
        uses realm
    xx
    phase: between
        uses dealings
    xx
    phase: settle
        every 1 tick
            settle_year(self)
        xx
        transition mutate where chance(settle_down(self))
            into: Village
            carries:
                rank: 2
            xx
        xx
        uses founding
        uses conquest
        uses unification
    xx
xx
<>Village |
    uses Polity
    uses downfall, breakup, regime
    rank: 2
    ~aggression: .35
    ~cooperation: .6
    ~cohesion: .65
    ~tradition: .65
    ~legitimacy: .6
    ~openness: .4
    ~discipline: .35
    ~centralization: .2
    ~learning: .05
    phase: inside
        uses govern
        uses answers
        uses realm
    xx
    phase: between
        uses dealings
    xx
    phase: settle
        every 1 tick
            settle_year(self)
        xx
        transition mutate where chance(rise_city(self))
            into: CityState
            carries:
                rank: 3
            xx
        xx
        transition mutate where chance(unsettle(self))
            into: Tribe
            carries:
                rank: 1
            xx
        xx
        uses founding
        uses conquest
        uses unification
    xx
xx
<>CityState |
    uses Polity
    uses downfall, breakup, regime
    rank: 3
    ~cooperation: .55
    ~openness: .6
    ~tradition: .45
    ~discipline: .5
    ~centralization: .5
    ~tolerance: .55
    ~learning: .25
    phase: inside
        uses govern
        uses answers
        uses realm
        uses court
    xx
    phase: between
        uses dealings
    xx
    phase: settle
        every 1 tick
            settle_year(self)
        xx
        transition mutate where chance(rise_kingdom(self))
            into: Kingdom
            carries:
                rank: 4
            xx
        xx
        transition mutate where chance(fall_city(self))
            into: Village
            carries:
                rank: 2
            xx
        xx
        uses founding
        uses conquest
        uses unification
    xx
xx
<>Kingdom |
    uses Polity
    uses downfall, breakup, regime
    rank: 4
    ~ambition: .55
    ~legitimacy: .6
    ~discipline: .5
    ~centralization: .5
    ~learning: .15
    phase: inside
        uses govern
        uses answers
        uses realm
        uses court
    xx
    phase: between
        uses dealings
    xx
    phase: settle
        every 1 tick
            settle_year(self)
        xx
        transition mutate where chance(rise_empire(self))
            into: Empire
            carries:
                rank: 5
            xx
        xx
        transition mutate where chance(rise_nation(self))
            into: NationState
            carries:
                rank: 6
            xx
        xx
        transition mutate where chance(fall_kingdom(self))
            into: CityState
            carries:
                rank: 3
            xx
        xx
        transition split where @partition
            into: Kingdom, Kingdom
            first:
                rank: 4
                wars: 0
                gold: @gold * .5
                army: @army * .5
                food: @food * .5
            xx
            second:
                name: next_name()
                rank: 4
                owner: nil
                wars: 0
                age: 0
                peoples: 1
                beaten_by: nil
                submits_to: nil
                union_with: nil
                colony_at: nil
                gold: @gold * .5
                army: @army * .5
                food: @food * .5
                debt: 0.0
            xx
        xx
        transition split where chance(shatter(self))
            into: Kingdom, CityState
            first:
                rank: 4
                wars: 0
                gold: @gold * .5
                army: @army * .5
                food: @food * .5
            xx
            second:
                name: next_name()
                rank: 3
                owner: nil
                wars: 0
                age: 0
                peoples: 1
                beaten_by: nil
                submits_to: nil
                union_with: nil
                colony_at: nil
                gold: @gold * .5
                army: @army * .5
                food: @food * .5
                debt: 0.0
            xx
        xx
        transition split where chance(civil_war(self))
            into: Kingdom, Kingdom
            first:
                rank: 4
                wars: 0
                gold: @gold * .5
                army: @army * .5
                food: @food * .5
            xx
            second:
                name: next_name()
                rank: 4
                owner: nil
                wars: 0
                age: 0
                peoples: 1
                beaten_by: nil
                submits_to: nil
                union_with: nil
                colony_at: nil
                gold: @gold * .5
                army: @army * .5
                food: @food * .5
                debt: 0.0
            xx
        xx
        transition fracture where chance(breakaway(self, true))
            into: CityState
            fragment:
                name: next_name()
                rank: 3
                owner: nil
                age: 0
                wars: 0
                peoples: 1
                beaten_by: nil
                submits_to: nil
                union_with: nil
                colony_at: nil
                lost_years: 0
                won_years: 0
                prestige: 0.0
                debt: 0.0
                gold: @gold * (@rebel >> people) / (@people + 1.0)
                army: @army * (@rebel >> people) / (@people + 1.0)
                food: @food * (@rebel >> people) / (@people + 1.0)
            xx
            carries:
                gold: @gold * (1.0 - (@rebel >> people) / (@people + 1.0))
                army: @army * (1.0 - (@rebel >> people) / (@people + 1.0))
                food: @food * (1.0 - (@rebel >> people) / (@people + 1.0))
            xx
        xx
        transition fracture where chance(breakaway(self, false))
            into: Kingdom
            fragment:
                name: next_name()
                rank: 4
                owner: nil
                age: 0
                wars: 0
                peoples: 1
                beaten_by: nil
                submits_to: nil
                union_with: nil
                colony_at: nil
                lost_years: 0
                won_years: 0
                prestige: 0.0
                debt: 0.0
                gold: @gold * (@rebel >> people) / (@people + 1.0)
                army: @army * (@rebel >> people) / (@people + 1.0)
                food: @food * (@rebel >> people) / (@people + 1.0)
            xx
            carries:
                gold: @gold * (1.0 - (@rebel >> people) / (@people + 1.0))
                army: @army * (1.0 - (@rebel >> people) / (@people + 1.0))
                food: @food * (1.0 - (@rebel >> people) / (@people + 1.0))
            xx
        xx
        uses founding
        uses conquest
        uses unification
    xx
xx
<>Empire |
    uses Polity
    uses downfall, breakup, regime
    rank: 5
    ~ambition: .7
    ~cohesion: .4
    ~discipline: .6
    ~centralization: .65
    ~tolerance: .55
    ~learning: .25
