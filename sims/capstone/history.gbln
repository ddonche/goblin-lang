/// Capstone steps 1 to 3: land, people, polities, their forms of
/// government and their transitions. The land fills for a prehistory
/// (step 1), then year 0 places the kingdoms at the homelands and tribes
/// and village communities on the settled land they do not hold, and the
/// history runs: each year the land phase, the accounts, the inside phase
/// (each polity's govern and realm decisions), the between phase (its
/// dealings with the others, and the wars) and the settle phase (changes
/// of form and the transitions).
/// Run from this folder: goblin run history.gbln
import map as map
import land as land
import polity as polity
import government as government
import family as family
import factions as factions
import overlays as overlays

act food_of(p)
    return p >> food
xx

act people_of(p)
    return p >> people
xx

act text(v)
    return :str(v)
xx

/// Whether p borders (or is) one of `homes`.
act beside_any(p, homes)
    repeat homes as h
        if h == p or :link_score(p, h, "border") => send true
    xx
    return false
xx

/// The settled provinces bordering `p` that no one holds, most people first.
act free_beside(p, min_people)
    out | []
    repeat :objects(Land, :link_score(p, it, "border") and it >> owner == nil and it >> people >= min_people) as q
        :put_last!(out, q)
    xx
    return :reverse(:sort_by(out, "people_of"))
xx

cfg | {
    "seed": 42,
    "provinces": 400,
    "kingdoms": 20,
    "prehistory": 1200,
    "years": 1000,
    "sample_every": 100,
    "land_share": 0.55,
    "edge_drop": 0.6,
    "steppe_dryness": 0.6,
    "coast_rain": 0.15,
    "river_flow": 8,
    "terrain_shares": {"mountains": 0.08, "hills": 0.14, "desert": 0.06, "steppe": 0.14, "forest": 0.25},
    "food": {"river": 1000.0, "plain": 500.0, "coast": 400.0, "forest": 250.0, "hills": 200.0,
        "steppe": 120.0, "mountains": 60.0, "desert": 40.0},
    "homeland_fill": 0.3,
    /// A kingdom takes its homeland and up to this many settled
    /// provinces beside it; a tribe or village community up to two.
    "kingdom_lands": 4,
    /// The fewest people a province needs for a polity to form on it.
    "settled": 20.0,
    "csv": "history_metrics.csv",
    "events": "history_events.txt"
}
years      | :int(:env("YEARS") ?? cfg{"years"})
prehistory | :int(:env("PREHISTORY") ?? cfg{"prehistory"})

t_start | :epoch_ms()
m       | map::generate(cfg)
kinds   | map::terrain(m, cfg)
width   | m{"width"}
height  | m{"height"}

at    | {}
lands | []
repeat kinds as k
    if k == "sea" => skip
    x | idx % width
    y | idx // width
    p <> Land | name: "{x},{y}", x: x, y: y, terrain: k, food: cfg{"food"}{k}
    :update!(at{:str(idx)}, p)
    :put_last!(lands, p)
xx
/// Every pair of bordering provinces, once.
pairs | []
repeat lands as p
    i | p >> y * width + p >> x
    repeat map::around(i, width, height) as j
        q | at{:str(j)} ?? => skip
        :link!(p, q, border, 1)
        if j > i => :put_last!(pairs, [p, q])
    xx
xx

homes | []
repeat :reverse(:sort_by(lands, "food_of")) as p
    if :len(homes) >= cfg{"kingdoms"} => stop
    if beside_any(p, homes) => skip
    :put_last!(homes, p)
    p >> people |= cfg{"homeland_fill"} * p >> food
xx

/// Prehistory: only the land.
repeat prehistory
    tick()
        land
    xx
xx
t_pre | :epoch_ms() - t_start

/// Year 0: the kingdoms at the homelands, then tribes and village
/// communities on the settled land left, the most peopled first.
made | 0
repeat homes as h
    held | [h]
    repeat free_beside(h, cfg{"settled"}) as q
        if :len(held) > cfg{"kingdom_lands"} => stop
        :put_last!(held, q)
    xx
    polity::found("Kingdom", polity::next_name(), held, 0)
    made |= made + 1
xx
repeat :reverse(:sort_by(lands, "people_of")) as l
    if l >> people < cfg{"settled"} => stop
    if !(l >> owner).nix? => skip
    held | [l]
    repeat free_beside(l, cfg{"settled"}) as q
        if :len(held) >= 3 => stop
        :put_last!(held, q)
    xx
    class | "Tribe"
    if l >> settlement == "town" or l >> settlement == "city" or l >> settlement == "great city" => class |= "Village"
    polity::found(class, polity::next_name(), held, 0)
    made |= made + 1
xx
overlays::seed(:objects(Kingdom), :objects(uses govern, !:is_type(it, "Kingdom")), pairs)
nk | :len(:objects(Kingdom))
nv | :len(:objects(Village))
nt | :len(:objects(Tribe))
:say("year 0: {nk} kingdoms, {nv} village communities, {nt} tribes")

/// Every `sample_every` years: speed, polities of each class, the largest
/// polity's share of the held land, wars under way, and the share of
/// polity-years spent at war so far.
classes | ["Tribe", "Village", "CityState", "Kingdom", "Empire", "NationState", "League"]
head    | ["year", "wall_ms", "years_per_s", "rss_mb", "objects", "people", "polities"]
repeat classes as c
    :put_last!(head, c)
xx
:put_last!(head, "largest_lands")
:put_last!(head, "largest_share")
:put_last!(head, "wars_now")
:put_last!(head, "at_war_share")
:put_last!(head, "rulers")
:put_last!(head, "dynasties")
:write_text!(cfg{"csv"}, "{:join(head, ",")}\n")
:event_log(cfg{"events"})
t_run   | :epoch_ms()
/// Polity-years, and how many of them a war was under way.
lived  | 0
fought | 0
repeat :range(0, years + 1) as year
    if year > 0
        tick()
            land
            polity::account(lands, pairs)
            family::account(year)
            factions::account(year, lands, :objects(uses govern))
            overlays::account(year, lands, :objects(uses govern))
            inside
            between
            settle
        xx
        repeat :objects(uses dealings) as p
            lived |= lived + 1
            if p >> wars > 0 => fought |= fought + 1
        xx
    xx
    if year % cfg{"sample_every"} != 0 => skip
    now  | :epoch_ms() - t_run
    rate | 0.0
    if now > 0 => rate |= year * 1000.0 / now
    stats  | :metrics()
    ps     | :objects(uses dealings)
    big    | nil
    held   | 0
    people | 0.0
    repeat ps as p
        held |= held + p >> lands
        if big.nix? or p >> lands > big >> lands => big |= p
    xx
    repeat lands as l
        people |= people + l >> people
    xx
    row | [year, now, :round(rate, 1), stats{"rss_mb"}, stats{"objects"}, :round(people), :len(ps)]
    repeat classes as c
        n | 0
        repeat ps as p
            if :is_type(p, c) => n |= n + 1
        xx
        :put_last!(row, n)
    xx
    share | 0.0
    if held > 0 => share |= :float(big >> lands) / held
    :put_last!(row, big >> lands)
    :put_last!(row, :round(share, 3))
    :put_last!(row, :len(:objects(War)))
    ws | 0.0
    if lived > 0 => ws |= :float(fought) / lived
    :put_last!(row, :round(ws, 3))
    fc | family::counts()
    :put_last!(row, fc{"rulers"})
    :put_last!(row, fc{"dynasties"})
    :append_file!(cfg{"csv"}, "{:join(:map(row, "text"), ",")}\n")
    np  | :len(ps)
    now_at_war | :len(:objects(War))
    :say("year {year}: {np} polities, largest {big >> name} with {big >> lands} provinces, {now_at_war} wars")
xx
:event_log(nil)
:say("time: prehistory {prehistory} years {t_pre} ms, history {years} years {:epoch_ms() - t_run} ms")
share | 0.0
if lived > 0 => share |= :round(:float(fought) * 100.0 / lived, 1)
:say("check: share of polity-years at war: {share}%")
/// The forms of government at the end, most common first.
forms | {}
repeat :objects(uses govern) as p
    /// Read from its overlays: `form` is only set in the settle phase, so
    /// one founded this year has none yet.
    f | government::form_of(p) ?? "none"
    :update!(forms{f}, (forms{f} ?? 0) + 1)
xx
held | []
repeat forms as f, n
    :put_last!(held, "{f} {n}")
xx
:say("check: forms at the end: {:join(:sort(held), ", ")}")
/// What happened in the ruling families, and who rules at the end.
tl | []
repeat family::tally as k, n
    :put_last!(tl, "{k} {n}")
xx
:say("check: families: {:join(tl, ", ")}")
laws | {}
repeat :objects(uses court) as p
    w | p >> law
    if w == .. => w |= "none"
    :update!(laws{w}, (laws{w} ?? 0) + 1)
xx
held |= []
repeat laws as w, n
    :put_last!(held, "{w} {n}")
xx
:say("check: succession laws at the end: {:join(:sort(held), ", ")}")
/// What the groups did, and the largest group and idea at the end.
tl |= []
repeat factions::tally as k, n
    :put_last!(tl, "{k} {n}")
xx
:say("check: groups: {:join(tl, ", ")}")
tl |= []
repeat overlays::tally as k, n
    :put_last!(tl, "{k} {n}")
xx
:say("check: overlays: {:join(tl, ", ")}")
oc | overlays::counts(lands, :objects(uses govern))
:say("check: ideas at the end: tongues {oc{"tongues"}} (largest holds {oc{"largest_tongue"}} of all people), faiths {oc{"faiths"}} (largest {oc{"largest_faith"}}), creeds {oc{"creeds"}}; realms of more than one people {oc{"many_peoples"}}")
gc | factions::counts(lands)
:say("check: groups at the end: {gc{"groups"}}, largest share of a realm {gc{"largest_group"}}; ideas {gc{"ideas"}}, largest holds {gc{"largest_idea"}} of all people")
