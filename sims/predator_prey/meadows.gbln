/// Predator and prey on DES: rabbits eat grass, foxes eat rabbits, and both
/// starve without food. Each meadow is a region (an actor that owns the
/// meadow and what is in it); tick(meadows) runs one day in all of them at
/// once. Now and then an animal wanders to the next meadow: setting its
/// `owner` moves it there.
///
///   Grass   one patch per meadow; grows back 80 a day, up to 400.
///   Rabbit  burns 1 energy a day; grazes (decision `graze`); has a kit
///           when well fed; starves at 0.
///   Fox     burns 1 energy a day; when hungry, hunts a rabbit in its
///           meadow (decision `hunt`; the more rabbits there, the likelier
///           it succeeds); has a cub when well fed; starves at 0.
///
/// The two populations rise and fall in turn, about every 90 days.
///
/// A rabbit that is caught is set to 0 energy, and erased as soon as the
/// hunt is over: it can't graze or be hunted again that day.

:rand_seed(7)
n_meadows | 4
days | 360
if :env("DAYS") != ""
    days |= :int(:env("DAYS"))
xx
if :env("MEADOWS") != ""
    n_meadows |= :int(:env("MEADOWS"))
xx

<>Meadow |
    n: 0
xx

<>Grass |
    owner: nil
    ~amount: 400
    every 1 tick
        @amount |= :min(400, @amount + 80)
    end
xx

<>Rabbit |
    owner: nil
    ~energy: 6
    every 1 tick
        @energy |= @energy - 1
        if @energy >= 10 and (pick 1 from 1...4) == 1
            @energy |= @energy - 5
            kit <> Rabbit | owner: @owner, energy: 4
        xx
        wander(self)
    end
    graze | decision against Grass where [
        target >> owner == @owner and target >> amount >= 1
    ] by [ target >> amount ]
    judge using graze
        >= 0: eat_grass(target)
    end
    transition erase when @energy <= 0
    end
xx

<>Fox |
    owner: nil
    ~energy: 12
    every 1 tick
        @energy |= @energy - 1
        if @energy >= 25 and (pick 1 from 1...4) == 1
            @energy |= @energy - 12
            cub <> Fox | owner: @owner, energy: 10
        xx
        wander(self)
    end
    /// A fox hunts only when it is hungry.
    hunt | decision against Rabbit where [ @energy < 30 and target >> owner == @owner ]
    judge using hunt
        >= 0: catch(target)
    end
    transition erase when @energy <= 0
    end
xx

act eat_grass(r, g)
    g >> amount |= g >> amount - 1
    r >> energy |= :min(14, r >> energy + 2)
xx

/// The more rabbits in the meadow, the likelier a hunt succeeds: a few
/// rabbits hide well.
act catch(f, r)
    here | :len(:objects("Rabbit", it >> owner == f >> owner))
    if (pick 1 from 1...(here + 400)) <= here
        r >> energy |= 0
        f >> energy |= :min(40, f >> energy + 8)
    xx
xx

/// One animal in twenty a day wanders to the next meadow.
act wander(a)
    if n_meadows > 1 and (pick 1 from 1...20) == 1
        next | (a >> owner >> n + 1) % n_meadows
        a >> owner |= :objects("Meadow", it >> n == next)[0]
    xx
xx

act make_meadow(n)
    meadow <> Meadow | n: n
    g <> Grass | owner: meadow
    repeat :range(0, 100)
        r <> Rabbit | owner: meadow, energy: 4 + (pick 1 from 0...6)
    xx
    repeat :range(0, 5)
        f <> Fox | owner: meadow, energy: 8 + (pick 1 from 0...8)
    xx
    return meadow
xx

meadows | []
repeat :range(0, n_meadows) as n
    :put_last!(meadows, :actor(make_meadow(n)))
xx

say("predator and prey: {n_meadows} meadows, {days} days")
repeat :range(1, days + 1) as t
    tick(meadows)
    if t % 10 == 0 or t == days
        grass | 0
        repeat :objects("Grass") as g
            grass |= grass + g >> amount
        xx
        rabbits | :len(:objects("Rabbit"))
        foxes | :len(:objects("Fox"))
        say("day {t}: rabbits {rabbits}, foxes {foxes}, grass {grass}")
    xx
xx
