/// An epidemic on DES: a sickness spreads between people in the same town,
/// lasts a while, and either kills or leaves its host immune. Each town is
/// a region (an actor that runs the town and the people in it); tick(towns)
/// runs one day in all of them at once. Now and then a person travels to
/// the next town: `:move!` takes them there, sickness and all.
///
///   sick    overlay: costs 1 health a day for 8 days; when it ends the
///           host is immune.
///           Each day each healthy person in a sick person's town catches
///           it with a chance of 4 in 1,000 (`spread: .004 where ...`).
///   Person  dies at 0 health (transition erase).

:rand_seed(11)
n_towns | 4
people_per_town | 100
days | 120
if :env("DAYS") != ""
    days |= :int(:env("DAYS"))
xx
if :env("PEOPLE") != ""
    people_per_town |= :int(:env("PEOPLE"))
xx

<>Town |
    n: 0
xx

<>Person |
    owner: nil
    health: 10
    immune: false
    every 1 tick
        if n_towns > 1 and (pick 1 from 1...30) == 1
            next | :objects(Town, it >> n == (@owner >> n + 1) % n_towns)[0]
            @owner |= next
            :move!(self, next)
        xx
    xx
    transition erase where @health <= 0
xx

overlay sick
    hosts: Person
    lasts: 8
    spread: .004 where (target >> owner) == @owner and (target >> immune) == false
    every 1 tick => @health |= @health - 1
    on end => @immune |= true
xx

act make_town(n)
    town <> Town | n: n
    all | [town]
    repeat :range(0, people_per_town) as i
        p <> Person | owner: town, health: 6 + (pick 1 from 0...8)
        /// Patient zero, in town 0.
        if n == 0 and i == 0
            :overlay!(p, sick)
        xx
        :put_last!(all, p)
    xx
    return all
xx

towns | []
repeat :range(0, n_towns) as n
    :put_last!(towns, :actor(make_town(n)))
xx

say("epidemic: {n_towns} towns of {people_per_town}, {days} days")
repeat :range(1, days + 1) as d
    tick(towns)
    if d % 5 == 0 or d == days
        alive | :len(:objects(Person))
        ill | :len(:overlays(sick))
        immune | :len(:objects(Person, it >> immune))
        say("day {d}: alive {alive}, sick {ill}, immune {immune}, dead {n_towns * people_per_town - alive}")
    xx
xx
