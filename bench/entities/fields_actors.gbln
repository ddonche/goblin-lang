/// 20,000 entities x 20 numbers, split across W actors; one tick = every
/// actor updates its share, then all report (a barrier).
ns | :env("ENT_N") ?? "20000"
n | :int(ns)
ts | :env("ENT_TICKS") ?? "10"
ticks | :int(ts)
ws | :env("ENT_W") ?? "4"
w | :int(ws)
keys | []
for k in :range(0, 20)
    :put_last!(keys, "f{k}")
xx
act tick(st)
    i | 0
    m | :len(st{"es"})
    while i < m
        :update!(st{"es"}[i]{"f0"}, st{"es"}[i]{"f0"} + 1)
        :update!(st{"es"}[i]{"f1"}, st{"es"}[i]{"f1"} + st{"es"}[i]{"f0"})
        :update!(st{"es"}[i]{"f2"}, st{"es"}[i]{"f2"} + 2)
        :update!(st{"es"}[i]{"f3"}, st{"es"}[i]{"f3"} + 3)
        :update!(st{"es"}[i]{"f4"}, st{"es"}[i]{"f4"} + 4)
        :update!(st{"es"}[i]{"f5"}, st{"es"}[i]{"f5"} + 5)
        :update!(st{"es"}[i]{"f6"}, st{"es"}[i]{"f6"} + 6)
        :update!(st{"es"}[i]{"f7"}, st{"es"}[i]{"f7"} + 7)
        :update!(st{"es"}[i]{"f8"}, st{"es"}[i]{"f8"} + 8)
        :update!(st{"es"}[i]{"f9"}, st{"es"}[i]{"f9"} + 9)
        :update!(st{"es"}[i]{"f10"}, st{"es"}[i]{"f10"} + 1)
        :update!(st{"es"}[i]{"f11"}, st{"es"}[i]{"f11"} + 1)
        :update!(st{"es"}[i]{"f12"}, st{"es"}[i]{"f12"} + 1)
        :update!(st{"es"}[i]{"f13"}, st{"es"}[i]{"f13"} + 1)
        :update!(st{"es"}[i]{"f14"}, st{"es"}[i]{"f14"} + 1)
        :update!(st{"es"}[i]{"f15"}, st{"es"}[i]{"f15"} + 1)
        :update!(st{"es"}[i]{"f16"}, st{"es"}[i]{"f16"} + 1)
        :update!(st{"es"}[i]{"f17"}, st{"es"}[i]{"f17"} + 1)
        :update!(st{"es"}[i]{"f18"}, st{"es"}[i]{"f18"} + 1)
        :update!(st{"es"}[i]{"f19"}, st{"es"}[i]{"f19"} + st{"es"}[i]{"f18"})
        i |= i + 1
    xx
    return st
xx
act part(st, msg)
    st |= tick(st)
    :post(st{"done"}, 1)
    return st
xx
done | :channel(w)
hs | []
for p in :range(0, w)
    es | []
    i | p
    while i < n
        e | {}
        for k in keys
            :update!(e{k}, i % 7)
        xx
        :put_last!(es, e)
        i |= i + w
    xx
    :put_last!(hs, :actor({"es": es, "done": done}, part))
xx
t0 | :epoch_ms()
t | 0
while t < ticks
    for h in hs
        :post(h, 1)
    xx
    for h in hs
        :receive(done)
    xx
    t |= t + 1
xx
t1 | :epoch_ms()
dt | t1 - t0
per | dt / ticks
say("{w} actors: {ticks} ticks in {dt} ms, {per} ms per tick")
for h in hs
    :halt(h)
xx
